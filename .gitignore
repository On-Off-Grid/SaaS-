# ------------------------------------------------------------------------------
# pi-hunt — machine-local / runtime / secret / output directories
# ------------------------------------------------------------------------------

# Local agent / runtime state
.pi/
.browser-live/
.codex/
.junie/
.agents/
*.pid
*.lock

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Node
node_modules/
npm-debug.log
yarn-error.log

# Environment / secrets
.env
.env.*
*.key
*.pem
credentials.json
gcp-oauth.keys.json

# Config layer — commit the templates (config/*.toml, config/secrets/*.env.example);
# never the filled-in local files.
config/engagement.local.toml
config/machines.local.toml
config/secrets/*.env
!config/secrets/*.env.example

# Generated by `pihunt-config build` (machine-specific; regenerated at install)
build/

# Build artifacts / logs
*.log
dist/
build/

# OS
.DS_Store
Thumbs.db

# Hunt output (user-specific)
reports/
recon-output/

# Prompt-build backups (machine-local rollback copies)
*.bak-*

# Third-party system-prompt corpus — reference material, not redistributed
CL4R1T4S/

# Burp MCP jars (installed manually; third-party + large — never commit)
burp-mcp-all.jar
mcp-servers/burp-mcp-proxy/*.jar

# Vendored JS deps (install with: npm --prefix bin install)
pi-agent/node_modules-js/

# never commit loose API keys
.intigriti_key.txt
*.key.txt
