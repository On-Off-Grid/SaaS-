#!/usr/bin/env bash
# pi-4.8 — Kimi flagship quality toggle for the pi-hunt stack.
#
#   pi-4.8 on      Kimi flagship agents + coordinator -> Kimi K3.1 Pro (premium)
#   pi-4.8 off     Kimi flagship agents + coordinator -> Kimi K3 (conservative)
#   pi-4.8         show current state (status)
#
# This toggle only touches agents that are ALREADY on a kimi-coding model. Hunters
# moved to DeepSeek/Gemini by `pi-tier on` are left alone, so running this does not
# silently pull the hunter fleet back onto Kimi. The coordinator is stored in
# ~/.pi/agent/.coordinator-model (read by pi-hunt).
#
# Fixed tiers this toggle NEVER touches:
#   - elite pair (strict-triager, hypothesis-redteam): always kimi-coding/k3.1-pro
#   - mechanical agents: managed by pi-tier
#
# To return to the elite-only routing after using this toggle:
#   pi-tier on
#   pi-tier set-coordinator amd-radeon/DeepSeek-V4.1-Flash:high
#
# Effect applies to the NEXT `pi-hunt` launch and any new subagent spawns; a
# running session keeps its model until you relaunch or /model-switch it.
set -uo pipefail

AGENTS="$HOME/.pi/agent/agents"
SETTINGS="$HOME/.pi/agent/settings.json"
COORD_STATE="$HOME/.pi/agent/.coordinator-model"

ELITE=(strict-triager hypothesis-redteam)
FAST=(h1-scope-loader intigriti-scope-loader yeswehack-scope-loader recon
      test-account-manager visual-security payload-researcher wordlist-curator)
DEFAULT_REF="kimi-coding/k3"
PREMIUM_REF="kimi-coding/k3.1-pro"
DEFAULT_MODEL_ID="k3"
PREMIUM_MODEL_ID="k3.1-pro"

ok(){ printf '  \033[1;32m✓\033[0m %s\n' "$*"; }
err(){ printf '  \033[1;31m✗ %s\033[0m\n' "$*"; }

is_in(){ local x; for x in "${@:2}"; do [ "$x" = "$1" ] && return 0; done; return 1; }

coord_model(){ cat "$COORD_STATE" 2>/dev/null || echo "$DEFAULT_REF:xhigh"; }

set_agent(){ # file, full model ref
  sed -i -E "s|^model:[[:space:]]*.*$|model: $2|" "$1"
}

set_coord(){ # full model ref, keeps the :thinking suffix
  local ref="$1" suffix=":xhigh"
  if [[ "$ref" == *:* ]]; then suffix=":${ref##*:}"; ref="${ref%%:*}"; fi
  echo "$ref$suffix" > "$COORD_STATE"
}

set_default_model(){ python3 - "$1" <<'PY'
import json, os, sys
p = os.path.expanduser("~/.pi/agent/settings.json")
d = json.load(open(p)); d["defaultModel"] = sys.argv[1]; json.dump(d, open(p, "w"), indent=2)
PY
}

elite_files(){ for a in "${ELITE[@]}"; do [ -f "$AGENTS/$a.md" ] && printf '%s\n' "$AGENTS/$a.md"; done; }

flagship_files(){
  for f in "$AGENTS"/*.md; do
    local a; a=$(basename "$f" .md)
    if ! is_in "$a" "${ELITE[@]}" && ! is_in "$a" "${FAST[@]}" \
       && grep -qE '^model:[[:space:]]*kimi-coding/' "$f"; then
      printf '%s\n' "$f"
    fi
  done
}

status(){
  local nf=0 ne=0 nh=0 nk=0 f
  printf '  coordinator : %s\n' "$(coord_model)"
  for f in "$AGENTS"/*.md; do
    local a m; a=$(basename "$f" .md)
    m=$(grep -m1 -oE '^model:[[:space:]]*[a-zA-Z0-9-]+/[a-zA-Z0-9./:-]+' "$f" | sed -E 's|^model:[[:space:]]*||')
    if is_in "$a" "${ELITE[@]}"; then
      ne=$((ne+1)); [ "$m" = "$PREMIUM_REF" ] || printf '  NOTE: elite %s is on %s (expected %s)\n' "$a" "$m" "$PREMIUM_REF"
    elif is_in "$a" "${FAST[@]}"; then nf=$((nf+1))
    elif [[ "$m" == kimi-coding/* ]]; then nk=$((nk+1))
    else nh=$((nh+1)); fi
  done
  printf '  subagents   : %s Kimi flagship | %s non-Kimi hunters | %s mechanical (pi-tier)\n' "$nk" "$nh" "$nf"
  printf '  elite pair  : %s/%s on %s\n' "$ne" "${#ELITE[@]}" "$PREMIUM_REF"
  printf '  defaultModel: %s\n' "$(python3 -c 'import json,os;print(json.load(open(os.path.expanduser("~/.pi/agent/settings.json"))).get("defaultModel"))' 2>/dev/null)"
}

case "${1:-status}" in
  on)
    while IFS= read -r f; do set_agent "$f" "$PREMIUM_REF"; done < <(flagship_files)
    set_coord "$PREMIUM_REF"
    while IFS= read -r f; do set_agent "$f" "$PREMIUM_REF"; done < <(elite_files)
    set_default_model "$PREMIUM_MODEL_ID"
    ok "Kimi PREMIUM: coordinator + Kimi flagship agents -> $PREMIUM_REF"
    status
    ;;
  off)
    while IFS= read -r f; do set_agent "$f" "$DEFAULT_REF"; done < <(flagship_files)
    set_coord "$DEFAULT_REF"
    while IFS= read -r f; do set_agent "$f" "$PREMIUM_REF"; done < <(elite_files)
    set_default_model "$DEFAULT_MODEL_ID"
    ok "Kimi CONSERVATIVE: coordinator + Kimi flagship agents -> $DEFAULT_REF (elite stays $PREMIUM_REF)"
    status
    ;;
  status|"") status;;
  -h|--help|help) sed -n '2,24p' "$0" | sed 's/^#\s\?//';;
  *) err "usage: pi-4.8 {on|off|status}"; exit 1;;
esac
