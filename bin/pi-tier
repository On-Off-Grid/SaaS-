#!/usr/bin/env bash
# pi-tier — cost/perf model tiering for the pi-hunt subagents.
#
# Three subagent classes:
#   mechanical (8)             scope loading, recon mapping, account setup, UI
#                              observation, payload lookup -> fast ref (Mistral)
#   hunters (all other agents) exploit/analysis specialists -> hunter ref
#                              (DeepSeek V4.1 Flash on AMD)
#   elite pair                 strict-triager + hypothesis-redteam -> Kimi k3.1-pro
#
# The coordinator is separate: `pi-tier set-coordinator <provider/model[:thinking]>`
# writes ~/.pi/agent/.coordinator-model, which pi-hunt reads at launch. This keeps
# Kimi reserved for the elite pair while the coordinator runs on the cheap provider.
#
#   pi-tier on                         apply tiering (mechanical/hunters/elite)
#   pi-tier off                        mechanical + hunters -> Kimi flagship fallback
#   pi-tier status                     show current per-agent models and state
#   pi-tier set-fast <provider/model>  change the mechanical model ref
#   pi-tier set-hunter <provider/model> change the hunter model ref
#   pi-tier set-flagship <model>       change the Kimi fallback used by `off`
#   pi-tier set-coordinator <ref>      change the pi-hunt coordinator model
#   pi-tier hybrid [once|watch [sec]|status|off] [--coord]
#                                      Kimi/AMD failover: run elite pair on Kimi
#                                      while its 5h quota is up, auto-revert to AMD
#                                      on 429, and return to Kimi when it resets.
#                                      'once' reconciles now; 'watch' polls (default
#                                      120s) and flips on each transition. Coordinator
#                                      stays on AMD unless --coord is given (it is the
#                                      per-turn token hog that exhausts the quota).
#                                      Elite applies at next subagent spawn; a
#                                      coordinator change applies at next launch.
#   pi-tier amd-fallback  [once|watch [sec]|status|off|reset]
#                                      AMD $1/day cap -> OpenRouter DeepSeek, back
#                                      on reset. Probes + manages ONLY the metered
#                                      DeepSeek-V4.1-Flash agents; the free
#                                      V4-Flash agents are never capped, left alone.
#   pi-tier groq-fallback [once|watch [sec]|status|off|reset]
#                                      Groq free-tier (Qwen) 429/down -> OpenRouter
#                                      DeepSeek, back on recovery. Manages agents
#                                      pinned to groq-direct; idles if none.
#   pi-tier coord-health [once|watch [sec]|status|off]
#                                      Coordinator-provider failover. Probes the
#                                      coordinator's current provider; if it is
#                                      down (429/402/401/unreachable) — the cause
#                                      of a silent hunt freeze — stages the first
#                                      healthy fallback (OpenRouter -> AMD -> Kimi)
#                                      into the coordinator slot for the next
#                                      launch and logs/announces it loudly. It
#                                      cannot relaunch the TUI, so a running frozen
#                                      hunt still needs a manual relaunch — but the
#                                      relaunch then comes up on a healthy provider.
#   pi-tier concurrency [once|watch [sec]|status|off]
#                                      Scale PI_SUBAGENT_MAX_CONCURRENCY by how many
#                                      LLM providers are up: all three (OpenRouter +
#                                      AMD + Kimi) -> high (6); two -> mid (4);
#                                      OpenRouter-only or none -> base (3). Writes
#                                      pihunt-tuning.env; applies at NEXT launch, so
#                                      re-source that env / open a new shell first.
#   pi-tier stall-watch [once|watch [sec]|status|off]
#                                      Hung-hunt watchdog. A wedged coordinator
#                                      (empty end_turn freeze) or a subagent stuck
#                                      on "(running)" emits no events, so nothing
#                                      in-process can alert. This polls the newest
#                                      write across all session transcripts + the
#                                      project casefile; if pi is alive but nothing
#                                      advanced for PIHUNT_STALL_THRESHOLD (600s),
#                                      it rings the desk (notify-send/paplay/spd-say)
#                                      so you can relaunch/steer. Run it alongside a
#                                      hunt: `pi-tier stall-watch watch 120 &`.
#
# Fast/hunter/coordinator refs must exist in ~/.pi/agent/models.json. Effect
# applies to NEW subagent spawns; a running session keeps its model until relaunch.
# The elite pair is always pinned to kimi-coding/k3.1-pro.
set -uo pipefail

AGENTS="$HOME/.pi/agent/agents"
MODELS_JSON="$HOME/.pi/agent/models.json"
FAST_STATE="$HOME/.pi/agent/.tier-state"
HUNTER_STATE="$HOME/.pi/agent/.hunter-state"
FLAGSHIP_STATE="$HOME/.pi/agent/.flagship-state"
COORD_STATE="$HOME/.pi/agent/.coordinator-model"
OVERRIDES_FILE="$HOME/.pi/agent/.agent-overrides"
# Config overlay: `pihunt-config build` writes tier defaults + agent arrays +
# COORD_FALLBACKS + CONC_* here from config/*.toml. Sourced so it OVERRIDES the
# built-in fallbacks below; absent (not yet built) => behavior unchanged.
PIHUNT_TIER_DEFAULTS="${PIHUNT_TIER_DEFAULTS:-$HOME/.pi/agent/.tier-defaults.sh}"
[ -r "$PIHUNT_TIER_DEFAULTS" ] && . "$PIHUNT_TIER_DEFAULTS"

FAST_DEFAULT="${FAST_DEFAULT:-mistral-direct/codestral-latest}"
HUNTER_DEFAULT="${HUNTER_DEFAULT:-amd-radeon/DeepSeek-V4.1-Flash}"
FLAGSHIP_DEFAULT="${FLAGSHIP_DEFAULT:-openrouter/deepseek/deepseek-v4.1-flash}"   # was kimi-coding/k3; Kimi dropped 2026-10-28
COORD_DEFAULT="${COORD_DEFAULT:-amd-radeon/DeepSeek-V4.1-Flash:high}"
KIMI="kimi-coding"

if [ -z "${ELITE_AGENTS+x}" ]; then ELITE_AGENTS=(
  strict-triager
  hypothesis-redteam
); fi
ELITE_DEFAULT="${ELITE_DEFAULT:-openrouter/deepseek/deepseek-v4.1-flash}"   # was kimi-coding/k3.1-pro; elite pair now on paid OpenRouter

if [ -z "${FAST_AGENTS+x}" ]; then FAST_AGENTS=(
  h1-scope-loader
  intigriti-scope-loader
  yeswehack-scope-loader
  recon
  test-account-manager
  visual-security
  payload-researcher
  wordlist-curator
); fi

ok(){ printf '  \033[1;32m✓\033[0m %s\n' "$*"; }
err(){ printf '  \033[1;31m✗ %s\033[0m\n' "$*"; }

norm_ref(){ # bare kimi ids are accepted for backwards compatibility
  local ref="${1:-}"
  case "$ref" in
    "" ) echo "";;
    k3-256k|k3|k3.1-pro|k3.1-pro-highspeed) echo "$KIMI/$ref";;
    */*) echo "$ref";;
    *) echo "$KIMI/$ref";;
  esac
}

state_ref(){ # file, default
  local ref
  ref=$( [ -f "$1" ] && grep -m1 . "$1" 2>/dev/null || true )
  [ -n "$ref" ] && norm_ref "$ref" || norm_ref "$2"
}

fast_ref(){ state_ref "$FAST_STATE" "$FAST_DEFAULT"; }
hunter_ref(){ state_ref "$HUNTER_STATE" "$HUNTER_DEFAULT"; }
flagship_ref(){ state_ref "$FLAGSHIP_STATE" "$FLAGSHIP_DEFAULT"; }
coord_ref(){ state_ref "$COORD_STATE" "$COORD_DEFAULT"; }

have_model(){ # $1 = provider/model[:thinking]  (ollama ids may contain a :tag)
  case "$1" in openrouter/*) return 0 ;; esac   # openrouter is a pi BUILT-IN provider; its models aren't in models.json but pi resolves them at runtime (keyed from openrouter.env)
  local raw="${1#*/}"
  grep -q "\"id\":[[:space:]]*\"$raw\"" "$MODELS_JSON" 2>/dev/null && return 0
  local base="${raw%:*}"
  [ "$base" != "$raw" ] && grep -q "\"id\":[[:space:]]*\"$base\"" "$MODELS_JSON" 2>/dev/null
}

set_model(){ # $1=agent file, $2=full provider/model ref
  sed -i -E "s|^model:[[:space:]]*.*$|model: $2|" "$1"
}

apply_overrides(){ # re-apply per-agent overrides on top of tier defaults
  [ -f "$OVERRIDES_FILE" ] || return 0
  local line a ref n=0
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$line" in \#*) continue;; esac
    a="${line%%=*}"; ref="${line#*=}"
    [ -f "$AGENTS/$a.md" ] || continue
    have_model "$ref" || { err "override $a -> $ref not in models.json (skipped)"; continue; }
    set_model "$AGENTS/$a.md" "$ref"; n=$((n+1))
  done < "$OVERRIDES_FILE"
  [ "$n" -gt 0 ] && ok "re-applied $n per-agent override(s)"
  return 0
}

set_agent(){ # $1=agent $2=provider/model[:thinking]
  local a="$1" ref; ref=$(norm_ref "$2")
  [ -f "$AGENTS/$a.md" ] || { err "no such agent: $a (see 'pi-tier status')"; exit 1; }
  case "$ref" in */*) ;; *) err "ref must be provider/model (got '$ref')"; exit 1;; esac
  have_model "$ref" || { err "model '${ref#*/}' not in models.json"; exit 1; }
  mkdir -p "$(dirname "$OVERRIDES_FILE")"; touch "$OVERRIDES_FILE"
  grep -vE "^$a=" "$OVERRIDES_FILE" > "$OVERRIDES_FILE.tmp" 2>/dev/null || true
  echo "$a=$ref" >> "$OVERRIDES_FILE.tmp"; mv "$OVERRIDES_FILE.tmp" "$OVERRIDES_FILE"
  set_model "$AGENTS/$a.md" "$ref"
  invalidate_fb_snapshots
  ok "agent $a -> $ref (persisted; survives 'pi-tier on'; fallback snapshots refreshed)"
}

clear_agent(){ # $1=agent  (remove override, reset to tier default)
  local a="$1" ref
  [ -f "$OVERRIDES_FILE" ] && { grep -vE "^$a=" "$OVERRIDES_FILE" > "$OVERRIDES_FILE.tmp" 2>/dev/null || true; mv "$OVERRIDES_FILE.tmp" "$OVERRIDES_FILE"; }
  if is_fast_agent "$a"; then ref=$(fast_ref)
  elif is_elite_agent "$a"; then ref="$ELITE_DEFAULT"
  else ref=$(hunter_ref); fi
  [ -f "$AGENTS/$a.md" ] && set_model "$AGENTS/$a.md" "$ref"
  invalidate_fb_snapshots
  ok "agent $a override cleared -> $ref"
}

is_fast_agent(){ local a="$1"; for x in "${FAST_AGENTS[@]}"; do [ "$x" = "$a" ] && return 0; done; return 1; }
is_elite_agent(){ local a="$1"; for x in "${ELITE_AGENTS[@]}"; do [ "$x" = "$a" ] && return 0; done; return 1; }
is_hunter_agent(){ is_fast_agent "$1" && return 1; is_elite_agent "$1" && return 1; return 0; }

agent_ref(){ # $1=agent file -> first provider/model ref found
  grep -m1 -oE 'model:[[:space:]]*[a-zA-Z0-9-]+/[a-zA-Z0-9./:-]+' "$1" 2>/dev/null | sed -E 's|^model:[[:space:]]*||'
}

status(){
  local n=0 nf=0 ne=0 nh=0
  printf '  %-26s %-40s %s\n' "AGENT" "MODEL" "CLASS"
  for f in "$AGENTS"/*.md; do
    local a m; a=$(basename "$f" .md); m=$(agent_ref "$f")
    if is_fast_agent "$a"; then printf '  %-26s %-40s (mechanical)\n' "$a" "$m"; nf=$((nf+1))
    elif is_elite_agent "$a"; then printf '  %-26s %-40s (elite)\n' "$a" "$m"; ne=$((ne+1))
    else printf '  %-26s %-40s (hunter)\n' "$a" "$m"; nh=$((nh+1)); fi
    n=$((n+1))
  done
  echo "  fast=$(fast_ref) | hunter=$(hunter_ref) | kimi-fallback=$(flagship_ref) | coordinator=$(coord_ref)"
  [ -s "$OVERRIDES_FILE" ] && echo "  per-agent overrides: $(grep -cvE '^[[:space:]]*(#|$)' "$OVERRIDES_FILE") (see $OVERRIDES_FILE)"
  echo "  $n agents ($nf mechanical, $nh hunters, $ne elite)"
}

apply_on(){
  local FM HM
  FM=$(fast_ref); HM=$(hunter_ref)
  case "$FM" in */*) ;; *) err "fast ref must be provider/model (got '$FM')"; exit 1;; esac
  case "$HM" in */*) ;; *) err "hunter ref must be provider/model (got '$HM')"; exit 1;; esac
  have_model "$FM" || { err "fast model '${FM#*/}' not in models.json"; exit 1; }
  have_model "$HM" || { err "hunter model '${HM#*/}' not in models.json"; exit 1; }
  for f in "$AGENTS"/*.md; do
    a=$(basename "$f" .md)
    if is_fast_agent "$a"; then set_model "$f" "$FM"
    elif is_elite_agent "$a"; then set_model "$f" "$ELITE_DEFAULT"
    else set_model "$f" "$HM"; fi
  done
  ok "tiering ON: ${#FAST_AGENTS[@]} mechanical -> $FM | hunters -> $HM | ${#ELITE_AGENTS[@]} elite -> $ELITE_DEFAULT"
  ok "coordinator unchanged: $(coord_ref) (use 'pi-tier set-coordinator <ref>' to change)"
  apply_overrides
  status
}

apply_off(){
  local FL
  FL=$(flagship_ref)
  case "$FL" in */*) ;; *) err "flagship ref must be provider/model (got '$FL')"; exit 1;; esac
  have_model "$FL" || { err "flagship model '${FL#*/}' not in models.json"; exit 1; }
  for f in "$AGENTS"/*.md; do
    a=$(basename "$f" .md)
    if is_elite_agent "$a"; then set_model "$f" "$ELITE_DEFAULT"
    else set_model "$f" "$FL"; fi
  done
  ok "tiering OFF: all non-elite agents -> $FL | elite stays $ELITE_DEFAULT"
  ok "coordinator unchanged: $(coord_ref)"
  apply_overrides
  status
}

set_state(){
  local file="$1" ref="$2" label="$3"
  ref=$(norm_ref "$ref")
  case "$ref" in */*) ;; *) err "$label ref must be provider/model (got '$ref')"; exit 1;; esac
  have_model "$ref" || { err "model '${ref#*/}' not in models.json"; exit 1; }
  echo "$ref" > "$file"; ok "$label ref = $ref (run 'pi-tier on' to apply)"
}

# ---------------- hybrid Kimi/AMD failover ----------------
# Uses Kimi for the elite pair (and optionally the coordinator) while Kimi's
# 5-hour quota is available, and auto-falls back to AMD when Kimi returns 429.
# The coordinator is pinned to AMD by default (it runs every turn and is what
# exhausts the Kimi quota); pass --coord to include it in the hybrid too.
HYBRID_STATE="$HOME/.pi/agent/.hybrid-provider"
HYBRID_PID="$HOME/.pi/agent/.hybrid.pid"
HYBRID_LOG="$HOME/.pi/agent/hybrid.log"
HYBRID_ELITE_KIMI="kimi-coding/k3.1-pro"
HYBRID_ELITE_AMD="openrouter/deepseek/deepseek-v4.1-flash"   # Kimi-down fallback: PAID OpenRouter DeepSeek V4.1-Flash (reasoning, 32k out) — free AMD reasoning model is quota-limited
HYBRID_COORD_KIMI="kimi-coding/k3.1-pro:high"
HYBRID_COORD_AMD="amd-radeon/DeepSeek-V4-Flash:high"
HYBRID_KEY_ENV="$HOME/.pi/secrets/kimi.env"
HYBRID_URL="https://api.kimi.com/coding/v1/chat/completions"
# Kimi quota is a 5h window that resets on a fixed schedule. Anchor to the known
# reset 2026-10-27 05:00:00 GMT; each window caps at 5h. The 429 poll is ground
# truth within a window; the schedule avoids wasted polls during cooldown and
# enforces the per-window cap (once 429'd, stay off Kimi until the window rolls).
HYBRID_KIMI_ANCHOR=1793077200          # 2026-10-27 05:00:00 UTC
HYBRID_KIMI_WINDOW=18000               # 5h cap per session/window (seconds)
HYBRID_KIMI_CAP_FILE="$HOME/.pi/agent/.hybrid-kimi-capped-until"

kimi_available(){ # 0 = quota up, 1 = 429/unreachable
  local key code
  [ -f "$HYBRID_KEY_ENV" ] && . "$HYBRID_KEY_ENV" 2>/dev/null
  key="${KIMI_API_KEY:-}"; [ -n "$key" ] || return 1
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 "$HYBRID_URL" \
    -H "Content-Type: application/json" -H "Authorization: Bearer $key" \
    -d '{"model":"k3.1-pro","messages":[{"role":"user","content":"x"}],"max_tokens":1}' 2>/dev/null || echo 000)
  case "$code" in 200|400) return 0;; *) return 1;; esac
}

kimi_win_bounds(){ # echoes "win_start win_end" for the window containing now (>=anchor)
  local now k; now=$(date +%s)
  k=$(( (now - HYBRID_KIMI_ANCHOR) / HYBRID_KIMI_WINDOW ))
  echo "$(( HYBRID_KIMI_ANCHOR + k*HYBRID_KIMI_WINDOW )) $(( HYBRID_KIMI_ANCHOR + (k+1)*HYBRID_KIMI_WINDOW ))"
}

kimi_usable(){ # schedule + 5h cap + 429 ground truth; 0 = use Kimi
  local now capped we
  now=$(date +%s)
  [ "$now" -lt "$HYBRID_KIMI_ANCHOR" ] && return 1          # pre-first-reset cooldown
  capped=$(cat "$HYBRID_KIMI_CAP_FILE" 2>/dev/null || echo 0)
  [ "$capped" -gt "$now" ] && return 1                      # already capped this window
  if kimi_available; then return 0; fi
  we=$(kimi_win_bounds); we=${we#* }                        # window end
  echo "$we" > "$HYBRID_KIMI_CAP_FILE"                      # 429 -> capped until window rolls
  return 1
}

hybrid_apply(){ # $1=kimi|amd  $2=with_coord(0/1)
  local prov="$1" coord="${2:-0}" a eref cref
  if [ "$prov" = kimi ]; then eref="$HYBRID_ELITE_KIMI"; cref="$HYBRID_COORD_KIMI"
  else eref="$HYBRID_ELITE_AMD"; cref="$HYBRID_COORD_AMD"; fi
  for a in "${ELITE_AGENTS[@]}"; do [ -f "$AGENTS/$a.md" ] && set_model "$AGENTS/$a.md" "$eref"; done
  [ "$coord" = 1 ] && echo "$cref" > "$COORD_STATE"
  printf '%s\n' "$prov" > "$HYBRID_STATE"
}

hybrid_reconcile(){ # $1=with_coord(0/1); prints on transition; 0=changed
  local cur desired want_coord="${1:-0}"
  cur=$(cat "$HYBRID_STATE" 2>/dev/null || echo "")
  if kimi_usable; then desired=kimi; else desired=amd; fi
  if [ "$desired" != "$cur" ]; then
    hybrid_apply "$desired" "$want_coord"
    local note="elite$([ "$want_coord" = 1 ] && echo "+coordinator")"
    printf '%s hybrid: %s -> %s (kimi %s) — %s now %s; coordinator applies at next launch, elite at next subagent spawn\n' \
      "$(date '+%F %T')" "${cur:-none}" "$desired" "$([ "$desired" = kimi ] && echo UP || echo BLOCKED)" "$note" "$desired" | tee -a "$HYBRID_LOG"
    return 0
  fi
  printf '%s hybrid: steady (%s)\n' "$(date '+%F %T')" "$desired" >> "$HYBRID_LOG"
  return 1
}

hybrid_watch(){ # $1=interval $2=with_coord
  local iv="${1:-120}" wc="${2:-0}"
  echo $$ > "$HYBRID_PID"
  ok "hybrid watch started (pid $$, every ${iv}s, coord=$([ "$wc" = 1 ] && echo yes || echo no)). Log: $HYBRID_LOG"
  trap 'rm -f "$HYBRID_PID"; exit 0' INT TERM
  hybrid_reconcile "$wc" || true
  while sleep "$iv"; do hybrid_reconcile "$wc" || true; done
}

hybrid_status(){
  local cur; cur=$(cat "$HYBRID_STATE" 2>/dev/null || echo "unset")
  echo "  hybrid last-applied provider : $cur"
  echo "  coordinator                  : $(coord_ref)"
  printf '  elite pair                   : '; for a in "${ELITE_AGENTS[@]}"; do agent_ref "$AGENTS/$a.md"; done | sort -u | tr '\n' ' '; echo
  local now; now=$(date +%s)
  if [ "$now" -lt "$HYBRID_KIMI_ANCHOR" ]; then
    echo "  kimi window                  : COOLDOWN until $(date -u -d @"$HYBRID_KIMI_ANCHOR" '+%F %H:%M')Z ($(( (HYBRID_KIMI_ANCHOR-now)/60 ))min)"
  else
    local wb ws we capped; wb=$(kimi_win_bounds); ws=${wb% *}; we=${wb#* }
    capped=$(cat "$HYBRID_KIMI_CAP_FILE" 2>/dev/null || echo 0)
    if [ "$capped" -gt "$now" ]; then echo "  kimi window                  : CAPPED (5h used) — rolls $(date -u -d @"$we" '+%H:%M')Z"
    elif kimi_available; then echo "  kimi window                  : OPEN $(date -u -d @"$ws" '+%H:%M')-$(date -u -d @"$we" '+%H:%M')Z"
    else echo "  kimi window                  : BLOCKED (429) — rolls $(date -u -d @"$we" '+%H:%M')Z"; fi
  fi
  if [ -f "$HYBRID_PID" ] && kill -0 "$(cat "$HYBRID_PID" 2>/dev/null)" 2>/dev/null; then echo "  watcher                      : running (pid $(cat "$HYBRID_PID"))"; else echo "  watcher                      : not running"; fi
  [ -f "$HYBRID_LOG" ] && { echo "  recent transitions:"; grep -- '->' "$HYBRID_LOG" 2>/dev/null | tail -3 | sed 's/^/    /'; }
}

hybrid_off(){
  if [ -f "$HYBRID_PID" ] && kill -0 "$(cat "$HYBRID_PID" 2>/dev/null)" 2>/dev/null; then
    kill "$(cat "$HYBRID_PID")" 2>/dev/null && ok "hybrid watcher stopped"
  else ok "no hybrid watcher running"; fi
  rm -f "$HYBRID_PID"
}

# ---------------- AMD daily-budget fallback (AMD $1/day cap -> OpenRouter) ----------------
# The AMD/Radeon $1/day cap is PER-MODEL: the metered DeepSeek-V4.1-Flash (reasoning,
# what hunters run) hits it and 429s, while the free DeepSeek-V4-Flash (mechanicals)
# never caps. So this probes V4.1-Flash specifically, and snapshots + flips ONLY the
# agents on that capped model to a paid OpenRouter equivalent, back when it resets.
# Agents on the free V4-Flash (and anything already off amd-radeon) are not in the
# snapshot, so they stay put.
AMDFB_HOME_FILE="$HOME/.pi/agent/.amdfb-home"
AMDFB_MODE_FILE="$HOME/.pi/agent/.amdfb-mode"
AMDFB_COOLDOWN_FILE="$HOME/.pi/agent/.amdfb-cooldown"   # epoch of last cap-flip to openrouter (debounce, stops the 5-min flap)
AMDFB_PID="$HOME/.pi/agent/.amdfb.pid"
AMDFB_LOG="$HOME/.pi/agent/amd-fallback.log"
AMDFB_AMD_ENV="$HOME/.pi/secrets/amd.env"
AMDFB_URL="https://developer.amd.com.cn/radeon/api/v1/chat/completions"
AMDFB_OR_HUNTER="openrouter/deepseek/deepseek-v4.1-flash"   # reasoning fallback for hunters
AMDFB_OR_FAST="openrouter/deepseek/deepseek-v4-flash"       # cheaper fallback for mechanical
AMDFB_CAPPED="amd-radeon/DeepSeek-V4.1-Flash"              # the metered model ($1/day cap)
AMDFB_PROBE_MODEL="DeepSeek-V4.1-Flash"                    # probe the CAPPED model — V4-Flash is free/uncapped so it never signals the cap

amd_usable(){ # 0 = capped-model budget OK, 1 = daily cap / unreachable
  local key code
  [ -f "$AMDFB_AMD_ENV" ] && . "$AMDFB_AMD_ENV" 2>/dev/null
  key="${RADEON_API_KEY:-}"; [ -n "$key" ] || return 1
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 "$AMDFB_URL" \
    -H "Content-Type: application/json" -H "Authorization: Bearer $key" \
    -d "{\"model\":\"$AMDFB_PROBE_MODEL\",\"messages\":[{\"role\":\"user\",\"content\":\"x\"}],\"max_tokens\":3}" 2>/dev/null || echo 000)
  [ "$code" = "200" ]
}

amdfb_snapshot(){ # record every agent currently on the CAPPED model (once); free
                  # V4-Flash agents are deliberately NOT managed — they never cap.
  [ -s "$AMDFB_HOME_FILE" ] && return 0
  : > "$AMDFB_HOME_FILE"; local f a m
  for f in "$AGENTS"/*.md; do a=$(basename "$f" .md); m=$(agent_ref "$f"); case "$m" in "$AMDFB_CAPPED") echo "$a=$m" >> "$AMDFB_HOME_FILE";; esac; done
  ok "amd-fallback: snapshotted $(grep -c = "$AMDFB_HOME_FILE") agent(s) on $AMDFB_CAPPED"
}

amdfb_apply(){ # $1 = amd | openrouter
  local mode="$1" line a home
  while IFS= read -r line; do
    [ -n "$line" ] || continue; a="${line%%=*}"; home="${line#*=}"
    [ -f "$AGENTS/$a.md" ] || continue
    if [ "$mode" = amd ]; then set_model "$AGENTS/$a.md" "$home"
    elif is_fast_agent "$a"; then set_model "$AGENTS/$a.md" "$AMDFB_OR_FAST"
    else set_model "$AGENTS/$a.md" "$AMDFB_OR_HUNTER"; fi
  done < "$AMDFB_HOME_FILE"
  printf '%s\n' "$mode" > "$AMDFB_MODE_FILE"
}

amdfb_reconcile(){ # prints on transition; 0 = changed. DEBOUNCED: after a cap-flip to openrouter, hold
  amdfb_snapshot                                 # openrouter for AMDFB_COOLDOWN before retrying AMD, so AMD's
  local cur desired now last cd                  # ~$1/day budget can't drive the 5-min flap that wedged subagents.
  cd="${PIHUNT_AMDFB_COOLDOWN:-7200}"
  cur=$(cat "$AMDFB_MODE_FILE" 2>/dev/null || echo "")
  if amd_usable; then desired=amd; else desired=openrouter; fi
  # hold on openrouter through the cooldown even if AMD looks usable again
  if [ "$desired" = amd ] && [ "$cur" = openrouter ]; then
    now=$(date +%s); last=$(cat "$AMDFB_COOLDOWN_FILE" 2>/dev/null || echo 0); case "$last" in ''|*[!0-9]*) last=0;; esac
    if [ $(( now - last )) -lt "$cd" ]; then
      printf '%s amd-fallback: steady (openrouter; AMD up but holding %ds/%ds cooldown to avoid flap)\n' "$(date "+%F %T")" "$(( now - last ))" "$cd" >> "$AMDFB_LOG"
      return 1
    fi
  fi
  if [ "$desired" != "$cur" ]; then
    amdfb_apply "$desired"
    [ "$desired" = openrouter ] && date +%s > "$AMDFB_COOLDOWN_FILE"   # start cooldown on cap-flip
    printf '%s amd-fallback: %s -> %s (AMD %s) — %s agents; applies at next subagent spawn\n' \
      "$(date "+%F %T")" "${cur:-none}" "$desired" "$([ "$desired" = amd ] && echo "budget reset/OK" || echo "daily cap hit")" "$(grep -c = "$AMDFB_HOME_FILE")" | tee -a "$AMDFB_LOG"
    return 0
  fi
  printf '%s amd-fallback: steady (%s)\n' "$(date "+%F %T")" "$desired" >> "$AMDFB_LOG"; return 1
}

amdfb_watch(){ local iv="${1:-300}"; echo $$ > "$AMDFB_PID"; ok "amd-fallback watch (pid $$, every ${iv}s). Log: $AMDFB_LOG"; trap 'rm -f "$AMDFB_PID"; exit 0' INT TERM; amdfb_reconcile || true; while sleep "$iv"; do amdfb_reconcile || true; done; }

amdfb_status(){
  amdfb_snapshot
  echo "  amd-fallback mode : $(cat "$AMDFB_MODE_FILE" 2>/dev/null || echo unset)"
  echo "  managed agents    : $(grep -c = "$AMDFB_HOME_FILE") on $AMDFB_CAPPED (snapshot: $AMDFB_HOME_FILE)"
  echo "  (free amd-radeon/DeepSeek-V4-Flash agents are left alone — never capped)"
  if amd_usable; then echo "  $AMDFB_PROBE_MODEL : OK (answering)"; else echo "  $AMDFB_PROBE_MODEL : CAPPED (\$1/day, 429) — using OpenRouter"; fi
  if [ -f "$AMDFB_PID" ] && kill -0 "$(cat "$AMDFB_PID" 2>/dev/null)" 2>/dev/null; then echo "  watcher           : running (pid $(cat "$AMDFB_PID"))"; else echo "  watcher           : not running"; fi
  [ -f "$AMDFB_LOG" ] && { echo "  recent:"; grep -- '->' "$AMDFB_LOG" 2>/dev/null | tail -3 | sed 's/^/    /'; }
}

amdfb_off(){ if [ -f "$AMDFB_PID" ] && kill -0 "$(cat "$AMDFB_PID" 2>/dev/null)" 2>/dev/null; then kill "$(cat "$AMDFB_PID")" 2>/dev/null && ok "amd-fallback watcher stopped"; else ok "no amd-fallback watcher running"; fi; rm -f "$AMDFB_PID"; }

# ---------------- Groq free-tier failover (Qwen) ----------------
# Agents can be pinned to Groq's free Qwen (e.g. the creative hunters). The free
# tier has RPM/TPM caps and no other watcher covers it. Mirrors amd-fallback:
# snapshot the agents currently on groq-direct, and when Groq 429s / is unreachable
# / the key is bad, swing them to the stable OpenRouter DeepSeek reasoning ref,
# reverting to their Groq home when it recovers. No-op when nothing is on Groq.
GROQFB_HOME_FILE="$HOME/.pi/agent/.groqfb-home"
GROQFB_MODE_FILE="$HOME/.pi/agent/.groqfb-mode"
GROQFB_PID="$HOME/.pi/agent/.groqfb.pid"
GROQFB_LOG="$HOME/.pi/agent/groq-fallback.log"
GROQFB_ENV="$HOME/.pi/secrets/groq.env"
GROQFB_URL="https://api.groq.com/openai/v1/chat/completions"
GROQFB_PROBE_MODEL="qwen/qwen3.8-27b"
GROQFB_FALLBACK="$AMDFB_OR_HUNTER"   # stable reasoning ref when Groq is capped

groq_usable(){ # 0 = Groq OK, 1 = rate-limited / unreachable / bad key
  local key code
  [ -f "$GROQFB_ENV" ] && . "$GROQFB_ENV" 2>/dev/null
  key="${GROQ_API_KEY:-}"; [ -n "$key" ] || return 1
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 "$GROQFB_URL" \
    -H "Content-Type: application/json" -H "Authorization: Bearer $key" \
    -d "{\"model\":\"$GROQFB_PROBE_MODEL\",\"messages\":[{\"role\":\"user\",\"content\":\"x\"}],\"max_tokens\":3}" 2>/dev/null || echo 000)
  [ "$code" = "200" ]
}

groqfb_count(){ local n; n=$(grep -c = "$GROQFB_HOME_FILE" 2>/dev/null); echo "${n:-0}"; }

groqfb_snapshot(){ # record home groq ref of every agent currently on groq-direct (once)
  [ -s "$GROQFB_HOME_FILE" ] && return 0
  : > "$GROQFB_HOME_FILE"; local f a m
  for f in "$AGENTS"/*.md; do a=$(basename "$f" .md); m=$(agent_ref "$f"); case "$m" in groq-direct/*) echo "$a=$m" >> "$GROQFB_HOME_FILE";; esac; done
  [ "$(groqfb_count)" -gt 0 ] && ok "groq-fallback: snapshotted $(groqfb_count) Groq-tier agent(s)" || true
}

groqfb_apply(){ # $1 = groq | fallback
  local mode="$1" line a home
  while IFS= read -r line; do
    [ -n "$line" ] || continue; a="${line%%=*}"; home="${line#*=}"
    [ -f "$AGENTS/$a.md" ] || continue
    if [ "$mode" = groq ]; then set_model "$AGENTS/$a.md" "$home"
    else set_model "$AGENTS/$a.md" "$GROQFB_FALLBACK"; fi
  done < "$GROQFB_HOME_FILE"
  printf '%s\n' "$mode" > "$GROQFB_MODE_FILE"
}

groqfb_reconcile(){ # prints on transition; 0 = changed
  groqfb_snapshot
  [ "$(groqfb_count)" -gt 0 ] || return 1   # nothing pinned to Groq -> nothing to do
  local cur desired; cur=$(cat "$GROQFB_MODE_FILE" 2>/dev/null || echo "")
  if groq_usable; then desired=groq; else desired=fallback; fi
  if [ "$desired" != "$cur" ]; then
    groqfb_apply "$desired"
    printf '%s groq-fallback: %s -> %s (Groq %s) — %s agent(s); applies at next subagent spawn\n' \
      "$(date "+%F %T")" "${cur:-none}" "$desired" "$([ "$desired" = groq ] && echo "reachable/OK" || echo "capped/down")" "$(groqfb_count)" | tee -a "$GROQFB_LOG"
    return 0
  fi
  printf '%s groq-fallback: steady (%s)\n' "$(date "+%F %T")" "$desired" >> "$GROQFB_LOG"; return 1
}

groqfb_watch(){ local iv="${1:-300}"; echo $$ > "$GROQFB_PID"; ok "groq-fallback watch (pid $$, every ${iv}s). Log: $GROQFB_LOG"; trap 'rm -f "$GROQFB_PID"; exit 0' INT TERM; groqfb_reconcile || true; while sleep "$iv"; do groqfb_reconcile || true; done; }

groqfb_status(){
  groqfb_snapshot
  echo "  groq-fallback mode: $(cat "$GROQFB_MODE_FILE" 2>/dev/null || echo unset)"
  echo "  managed agents    : $(groqfb_count) (home snapshot: $GROQFB_HOME_FILE)"
  [ "$(groqfb_count)" -eq 0 ] && echo "  note              : nothing pinned to groq-direct (watcher idles)"
  if groq_usable; then echo "  Groq free tier    : OK (reachable + keyed)"; else echo "  Groq free tier    : DOWN/CAPPED — using $GROQFB_FALLBACK"; fi
  if [ -f "$GROQFB_PID" ] && kill -0 "$(cat "$GROQFB_PID" 2>/dev/null)" 2>/dev/null; then echo "  watcher           : running (pid $(cat "$GROQFB_PID"))"; else echo "  watcher           : not running"; fi
  [ -f "$GROQFB_LOG" ] && { echo "  recent:"; grep -- '->' "$GROQFB_LOG" 2>/dev/null | tail -3 | sed 's/^/    /'; }
}

groqfb_off(){ if [ -f "$GROQFB_PID" ] && kill -0 "$(cat "$GROQFB_PID" 2>/dev/null)" 2>/dev/null; then kill "$(cat "$GROQFB_PID")" 2>/dev/null && ok "groq-fallback watcher stopped"; else ok "no groq-fallback watcher running"; fi; rm -f "$GROQFB_PID"; }

# A per-agent pin change (set-agent/clear-agent) makes the fallback watchers' one-time
# home snapshots stale — they would keep re-applying an agent's OLD provider and fight
# the new pin. Dropping the snapshot+mode files forces both watchers to re-derive their
# managed set from the now-current agent config on their next reconcile.
invalidate_fb_snapshots(){ rm -f "$AMDFB_HOME_FILE" "$AMDFB_MODE_FILE" "$GROQFB_HOME_FILE" "$GROQFB_MODE_FILE" 2>/dev/null || true; }

# ---------------- Coordinator-provider health failover ----------------
# The coordinator runs on one provider (currently OpenRouter). If THAT provider
# 429s/402s/goes down, the whole hunt freezes silently (the auto-continue watchdog
# only covers empty end_turn, not a dead coordinator). This probes the coordinator's
# provider and, when it is down, STAGES the first healthy fallback into the
# coordinator slot for the next launch. A coordinator model only applies at launch,
# so this cannot un-stick a live frozen hunt — but it guarantees the relaunch comes
# up healthy, and announces the freeze loudly so a relaunch happens.
COORDH_PID="$HOME/.pi/agent/.coordh.pid"
COORDH_LOG="$HOME/.pi/agent/coord-health.log"
OR_KEY_ENV="$HOME/.pi/secrets/openrouter.env"
OR_URL="https://openrouter.ai/api/v1/chat/completions"
# Reasoning-capable coordinator fallbacks, most-reliable first. Each is provider/model.
if [ -z "${COORD_FALLBACKS+x}" ]; then COORD_FALLBACKS=(
  "openrouter/deepseek/deepseek-v4.1-flash:high"
  "amd-radeon/DeepSeek-V4.1-Flash:high"
); fi

openrouter_usable(){ # 0 = OpenRouter answering, 1 = down/credits/429/bad key
  local key code
  [ -f "$OR_KEY_ENV" ] && . "$OR_KEY_ENV" 2>/dev/null
  key="${OPENROUTER_API_KEY:-}"; [ -n "$key" ] || return 1
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 "$OR_URL" \
    -H "Content-Type: application/json" -H "Authorization: Bearer $key" \
    -d '{"model":"deepseek/deepseek-v4.1-flash","messages":[{"role":"user","content":"x"}],"max_tokens":1}' 2>/dev/null || echo 000)
  case "$code" in 200|400) return 0;; *) return 1;; esac
}

# --- PLACEHOLDER for a future provider's health probe (codecraft removed 2026-10-28) ---
# Copy openrouter_usable, point it at the new provider's URL + key env, then add a
# `<name>) <name>_usable ;;` case in provider_usable and (optionally) a COORD_FALLBACKS entry.
# placeholder_usable(){ return 1; }

# Generic data-driven health probe. Uses the PIHUNT_PROBE_* table that
# `pihunt-config build` writes into .tier-defaults.sh from providers.toml.
# Returns 0 = answering, 1 = down/unconfigured, 2 = not in the table (caller falls back).
probe_provider_generic(){ # $1 = provider name
  [ -n "${PIHUNT_PROBE_PROVIDERS:-}" ] || return 2
  case " $PIHUNT_PROBE_PROVIDERS " in *" $1 "*) ;; *) return 2 ;; esac
  local kf kenv url model ok key code
  kf="${PIHUNT_PROBE_KEYFILE[$1]:-}"; kenv="${PIHUNT_PROBE_KEYENV[$1]:-}"
  url="${PIHUNT_PROBE_URL[$1]:-}"; model="${PIHUNT_PROBE_MODEL[$1]:-}"
  ok="${PIHUNT_PROBE_OKCODES[$1]:-200}"
  [ -n "$kf" ] && [ -r "$HOME/.pi/secrets/$kf" ] && . "$HOME/.pi/secrets/$kf" 2>/dev/null
  if [ -n "$kenv" ]; then key="${!kenv:-}"; else key=""; fi
  [ -n "$key" ] && [ -n "$url" ] || return 1
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 "$url" \
    -H "Content-Type: application/json" -H "Authorization: Bearer $key" \
    -d "{\"model\":\"$model\",\"messages\":[{\"role\":\"user\",\"content\":\"x\"}],\"max_tokens\":1}" 2>/dev/null || echo 000)
  case " $ok " in *" $code "*) return 0;; *) return 1;; esac
}

provider_usable(){ # $1 = provider segment of a ref
  # Data-driven probe (providers.toml) when the overlay provides a table; else the
  # built-in named probes below (overlay absent => unchanged behavior).
  probe_provider_generic "$1"; local rc=$?
  [ "$rc" != 2 ] && return "$rc"
  case "$1" in
    openrouter)  openrouter_usable ;;
    amd-radeon)  amd_usable ;;
    kimi-coding) kimi_available ;;
    *)           return 0 ;;   # unprobeable provider: assume up, don't flap
  esac
}

coordh_reconcile(){ # prints on transition; 0 = changed
  local cur curprov ref prov
  cur=$(coord_ref); curprov="${cur%%/*}"
  if provider_usable "$curprov"; then
    printf '%s coord-health: steady (%s, %s up)\n' "$(date '+%F %T')" "$cur" "$curprov" >> "$COORDH_LOG"
    return 1
  fi
  for ref in "${COORD_FALLBACKS[@]}"; do
    prov="${ref%%/*}"
    [ "$prov" = "$curprov" ] && continue
    if provider_usable "$prov"; then
      echo "$ref" > "$COORD_STATE"
      printf '%s coord-health: %s DOWN -> coordinator %s -> %s (%s up); applies at next launch — RELAUNCH to un-stick a frozen hunt\n' \
        "$(date '+%F %T')" "$curprov" "$cur" "$ref" "$prov" | tee -a "$COORDH_LOG"
      return 0
    fi
  done
  printf '%s coord-health: %s DOWN and NO healthy fallback — coordinator left at %s\n' \
    "$(date '+%F %T')" "$curprov" "$cur" | tee -a "$COORDH_LOG"
  return 1
}

coordh_watch(){ local iv="${1:-120}"; echo $$ > "$COORDH_PID"; ok "coord-health watch (pid $$, every ${iv}s). Log: $COORDH_LOG"; trap 'rm -f "$COORDH_PID"; exit 0' INT TERM; coordh_reconcile || true; while sleep "$iv"; do coordh_reconcile || true; done; }

coordh_status(){
  local cur curprov; cur=$(coord_ref); curprov="${cur%%/*}"
  echo "  coordinator          : $cur"
  if provider_usable "$curprov"; then echo "  coordinator provider : $curprov UP"
  else echo "  coordinator provider : $curprov DOWN — hunt likely FROZEN; relaunch to apply staged fallback"; fi
  echo "  fallback order       : ${COORD_FALLBACKS[*]}"
  if [ -f "$COORDH_PID" ] && kill -0 "$(cat "$COORDH_PID" 2>/dev/null)" 2>/dev/null; then echo "  watcher              : running (pid $(cat "$COORDH_PID"))"; else echo "  watcher              : not running"; fi
  [ -f "$COORDH_LOG" ] && { echo "  recent:"; grep -- '->' "$COORDH_LOG" 2>/dev/null | tail -3 | sed 's/^/    /'; }
}

coordh_off(){ if [ -f "$COORDH_PID" ] && kill -0 "$(cat "$COORDH_PID" 2>/dev/null)" 2>/dev/null; then kill "$(cat "$COORDH_PID")" 2>/dev/null && ok "coord-health watcher stopped"; else ok "no coord-health watcher running"; fi; rm -f "$COORDH_PID"; }

# ---------------- Provider-availability concurrency scaling ----------------
# PI_SUBAGENT_MAX_CONCURRENCY (in pihunt-tuning.env) caps simultaneous subagents.
# Scale it by how many LLM providers are usable right now: more free capacity ->
# fan out wider; OpenRouter-only (paid) -> stay conservative at the base. The
# subagent runner also self-throttles on the RAM floor, so raising this is safe.
# Applies at NEXT launch (pi reads the env at start); re-source pihunt-tuning.env
# or open a new shell before relaunching.
TUNING_ENV="$HOME/.pi/secrets/pihunt-tuning.env"
CONCWATCH_PID="$HOME/.pi/agent/.concwatch.pid"
CONCWATCH_LOG="$HOME/.pi/agent/concurrency.log"
CONC_HIGH="${CONC_HIGH:-6}"    # 3 providers up   (overridden by the machine profile via .tier-defaults.sh)
CONC_MID="${CONC_MID:-4}"      # 2 providers up
CONC_BASE="${CONC_BASE:-3}"    # OpenRouter-only (paid) or none

conc_current(){ grep -oE 'PI_SUBAGENT_MAX_CONCURRENCY=[0-9]+' "$TUNING_ENV" 2>/dev/null | head -1 | grep -oE '[0-9]+'; }

conc_providers(){ # echoes "<count>|<space-separated up list>"
  local n=0 up="" name
  if [ -n "${PIHUNT_PROBE_PROVIDERS:-}" ]; then      # data-driven (providers.toml probe=true)
    for name in $PIHUNT_PROBE_PROVIDERS; do
      probe_provider_generic "$name" && { n=$((n+1)); up="$up $name"; }
    done
  else                                               # fallback: built-in named probes
    openrouter_usable && { n=$((n+1)); up="$up openrouter"; }
    amd_usable        && { n=$((n+1)); up="$up amd"; }
    kimi_available    && { n=$((n+1)); up="$up kimi"; }
  fi
  echo "$n|$up"
}

conc_desired(){ # $1=count $2=up-list -> echoes desired concurrency
  local n="$1" up="$2"
  case "$n" in
    3) echo "$CONC_HIGH" ;;
    0) echo "$CONC_BASE" ;;
    1) if echo "$up" | grep -qw openrouter; then echo "$CONC_BASE"; else echo "$CONC_MID"; fi ;;
    *) echo "$CONC_MID" ;;
  esac
}

conc_set(){ # $1=value (preserves the trailing comment)
  if grep -qE '^export PI_SUBAGENT_MAX_CONCURRENCY=' "$TUNING_ENV" 2>/dev/null; then
    sed -i -E "s|^(export PI_SUBAGENT_MAX_CONCURRENCY=)[0-9]+|\1$1|" "$TUNING_ENV"
  else
    echo "export PI_SUBAGENT_MAX_CONCURRENCY=$1" >> "$TUNING_ENV"
  fi
}

conc_reconcile(){ # prints on transition; 0 = changed
  local pr n up cur want
  pr=$(conc_providers); n=${pr%%|*}; up=${pr#*|}
  cur=$(conc_current); want=$(conc_desired "$n" "$up"); [ -n "$cur" ] || cur="unset"
  if [ "$want" != "$cur" ]; then
    conc_set "$want"
    printf '%s concurrency: %s -> %s (%d providers up:%s) — applies at next launch; re-source pihunt-tuning.env\n' \
      "$(date '+%F %T')" "$cur" "$want" "$n" "${up:- none}" | tee -a "$CONCWATCH_LOG"
    return 0
  fi
  printf '%s concurrency: steady (%s, %d up:%s)\n' "$(date '+%F %T')" "$cur" "$n" "${up:- none}" >> "$CONCWATCH_LOG"
  return 1
}

conc_watch(){ local iv="${1:-300}"; echo $$ > "$CONCWATCH_PID"; ok "concurrency watch (pid $$, every ${iv}s). Log: $CONCWATCH_LOG"; trap 'rm -f "$CONCWATCH_PID"; exit 0' INT TERM; conc_reconcile || true; while sleep "$iv"; do conc_reconcile || true; done; }

conc_live(){ # echoes "<pid>:<value>" of the running pi process's env var, or empty
  local pid v
  for pid in $(pgrep -x pi 2>/dev/null); do
    v=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | sed -n 's/^PI_SUBAGENT_MAX_CONCURRENCY=//p' | head -1)
    [ -n "$v" ] && { echo "$pid:$v"; return 0; }
    echo "$pid:"; return 0
  done
  return 1
}

conc_status(){
  local pr n up cur want live lpid lval
  pr=$(conc_providers); n=${pr%%|*}; up=${pr#*|}
  cur=$(conc_current); want=$(conc_desired "$n" "$up")
  echo "  file (pihunt-tuning.env)    : ${cur:-unset}  ($TUNING_ENV)"
  live=$(conc_live); lpid=${live%%:*}; lval=${live#*:}
  if [ -n "$live" ]; then
    echo "  running pi (pid $lpid)        : ${lval:-<not in env>}  <- governs the LIVE hunt"
    if [ -n "$lval" ] && [ "$lval" != "${cur:-}" ]; then
      echo "  ⚠ live != file              : the hunt is running at $lval, file says ${cur:-unset} — re-source the env and RELAUNCH to apply the file value"
    fi
  else
    echo "  running pi                  : none (file value applies at next launch)"
  fi
  echo "  providers up                : $n —${up:- none}"
  echo "  desired for this state      : $want  (high=$CONC_HIGH mid=$CONC_MID base=$CONC_BASE)"
  if [ "${cur:-}" = "$want" ]; then echo "  file vs desired             : in sync"; else echo "  file vs desired             : OUT OF SYNC — run 'pi-tier concurrency once' to set the file to $want"; fi
  if [ -f "$CONCWATCH_PID" ] && kill -0 "$(cat "$CONCWATCH_PID" 2>/dev/null)" 2>/dev/null; then echo "  watcher                     : running (pid $(cat "$CONCWATCH_PID"))"; else echo "  watcher                     : not running"; fi
  [ -f "$CONCWATCH_LOG" ] && { echo "  recent:"; grep -- '->' "$CONCWATCH_LOG" 2>/dev/null | tail -3 | sed 's/^/    /'; }
}

conc_off(){ if [ -f "$CONCWATCH_PID" ] && kill -0 "$(cat "$CONCWATCH_PID" 2>/dev/null)" 2>/dev/null; then kill "$(cat "$CONCWATCH_PID")" 2>/dev/null && ok "concurrency watcher stopped"; else ok "no concurrency watcher running"; fi; rm -f "$CONCWATCH_PID"; }

# ---------------- Stall / hung-agent watchdog ----------------
# Nothing in-process can alert when the COORDINATOR itself wedges (the empty
# end_turn freeze) or when a subagent shows "(running)" on the TUI but produces
# no output: a hung loop emits no events, so the human-alert extension never
# fires. This external poller watches the newest write across all session
# transcripts + the project casefile. If a pi process is alive but nothing
# anywhere has advanced for the stall threshold, the hunt is effectively idle ->
# ring the desk (same notify path as human-alert) so the operator can relaunch
# or steer. It only surfaces the stall; it cannot un-stick the hunt.
#   PIHUNT_STALL_THRESHOLD (default 600s) idle time that counts as stalled
#   PIHUNT_STALL_REALARM   (default 900s) minimum gap between desk alarms
#   PIHUNT_CASEFILE        (default $PWD/.pi/casefile.jsonl) progress file to watch
#   PIHUNT_ALERT=0         silences the desk alarm (log only); PIHUNT_STALL_DRY_RUN=1 same
STALLW_PID="$HOME/.pi/agent/.stallwatch.pid"
STALLW_LOG="$HOME/.pi/agent/stall-watch.log"
STALLW_SESS_DIR="$HOME/.pi/agent/sessions"
STALLW_LAST_ALARM="$HOME/.pi/agent/.stallwatch-last-alarm"
STALLW_SOUND="/usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga"
STALLW_THRESH="${PIHUNT_STALL_THRESHOLD:-600}"          # hard alarm: no progress this long
STALLW_FASTPATH="${PIHUNT_STALL_FASTPATH:-240}"         # soft early-warning when hang-shaped (net-wait, no progress)
STALLW_REALARM="${PIHUNT_STALL_REALARM:-900}"
STALLW_CASEFILE="${PIHUNT_CASEFILE:-$PWD/.pi/casefile.jsonl}"
STALLW_STATE="$HOME/.pi/agent/.stall-state.json"        # machine-readable current classification (rewritten each tick)
STALLW_LEDGER="${PIHUNT_STALL_LEDGER:-$HOME/.pi/agent/stall-ledger.jsonl}"  # append-only stall history
STALLW_WEBHOOK="${PIHUNT_ALERT_WEBHOOK:-}"              # optional out-of-band POST (Slack/ntfy/Telegram {"text":...})
STALLW_COORD_LOG="$HOME/.pi/agent/coord-health.log"     # provider-down cross-reference
STALLW_CPU_WIN="${PIHUNT_STALL_CPU_WIN:-2}"             # seconds sampled to tell on-CPU (spinning) from blocked (waiting)

pi_alive(){ pgrep -x pi >/dev/null 2>&1; }
stallw_pids(){ pgrep -x pi 2>/dev/null; }

stallw_newest_mtime(){ # epoch secs of the most recent transcript/casefile write, or 0
  local newest=0 m
  if [ -d "$STALLW_SESS_DIR" ]; then
    m=$(find "$STALLW_SESS_DIR" -type f -name '*.jsonl' -printf '%T@\n' 2>/dev/null | sort -nr | head -1)
    [ -n "$m" ] && newest=${m%.*}
  fi
  if [ -f "$STALLW_CASEFILE" ]; then
    m=$(date -r "$STALLW_CASEFILE" +%s 2>/dev/null || echo 0)
    [ "$m" -gt "$newest" ] && newest="$m"
  fi
  echo "$newest"
}

# --- process + provider signals: turn a bare "idle" into a cause + action ---
stallw_cpu_ns(){ awk '{print $1+0}' "/proc/$1/schedstat" 2>/dev/null || echo 0; }  # cumulative on-CPU ns

stallw_root_pid(){ # the pi at the top of the tree (its ppid is not itself a pi); else the first pi
  local pids p pp; pids=" $(stallw_pids | tr '\n' ' ') "
  for p in $pids; do
    pp=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
    case "$pids" in *" $pp "*) : ;; *) echo "$p"; return 0 ;; esac
  done
  stallw_pids | head -1
}

stallw_proc_signal(){ # -> "ONCPU|BLOCKED <state> <wchan>"; samples CPU of all pi pids over the window
  local pids p a b sum=0 root st wc tmp
  pids=$(stallw_pids); [ -z "$pids" ] && { echo "GONE - -"; return; }
  tmp="$HOME/.pi/agent/.stallw-cpu.$$"; : > "$tmp"
  for p in $pids; do echo "$p $(stallw_cpu_ns "$p")" >> "$tmp"; done
  sleep "$STALLW_CPU_WIN"
  while read -r p a; do b=$(stallw_cpu_ns "$p"); sum=$((sum + b - a)); done < "$tmp"
  rm -f "$tmp"
  root=$(stallw_root_pid)
  st=$(ps -o stat= -p "$root" 2>/dev/null | tr -d ' '); st="${st:-?}"
  wc=$(cat "/proc/$root/wchan" 2>/dev/null); wc="${wc:-?}"
  if [ "$sum" -gt 50000000 ]; then echo "ONCPU $st $wc"; else echo "BLOCKED $st $wc"; fi   # >50ms CPU/window = working, not blocked
}

stallw_provider_down(){ # 0 if coord-health's newest line reports the coordinator provider DOWN (failover not yet applied)
  [ -f "$STALLW_COORD_LOG" ] || return 1
  case "$(tail -n 1 "$STALLW_COORD_LOG" 2>/dev/null)" in *DOWN*) return 0 ;; *) return 1 ;; esac
}

stallw_json_escape(){ printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

stallw_write_state(){ # $1=class $2=idle_s $3=proc_sig $4=action  -> rewrite the current-state file
  printf '{"ts":"%s","class":"%s","idle_s":%s,"proc":"%s","action":"%s","pids":"%s"}\n' \
    "$(date -Is 2>/dev/null)" "$1" "${2:-0}" "$(stallw_json_escape "$3")" "$(stallw_json_escape "$4")" \
    "$(stallw_pids | tr '\n' ' ' | sed 's/ *$//')" > "$STALLW_STATE" 2>/dev/null || true
}

stallw_ledger_add(){ # $1=class $2=idle_s $3=proc_sig $4=action  -> append one event
  printf '{"ts":"%s","class":"%s","idle_s":%s,"proc":"%s","action":"%s"}\n' \
    "$(date -Is 2>/dev/null)" "$1" "${2:-0}" "$(stallw_json_escape "$3")" "$(stallw_json_escape "$4")" \
    >> "$STALLW_LEDGER" 2>/dev/null || true
}

stallw_webhook(){ # $1=text ; best-effort, non-blocking, only when PIHUNT_ALERT_WEBHOOK is set
  [ -n "$STALLW_WEBHOOK" ] || return 0
  local t; t=$(stallw_json_escape "$1")
  ( curl -m 10 -sS -X POST -H 'Content-Type: application/json' --data "{\"text\":\"$t\"}" "$STALLW_WEBHOOK" >/dev/null 2>&1 & )
}

stallw_alarm(){ # $1=severity(soft|hard) $2=class $3=idle_s $4=proc_sig $5=message
  local sev="$1" class="$2" idle="$3" sig="$4" msg="$5" now last
  stallw_ledger_add "$class" "$idle" "$sig" "$msg"
  printf '%s stall-watch: %s [%s] %s\n' "$(date '+%F %T')" "$(printf '%s' "$sev" | tr '[:lower:]' '[:upper:]')" "$class" "$msg" | tee -a "$STALLW_LOG"
  [ "${PIHUNT_ALERT:-1}" = "0" ] && return 0
  [ "${PIHUNT_STALL_DRY_RUN:-0}" = "1" ] && return 0
  now=$(date +%s); last=$(cat "$STALLW_LAST_ALARM" 2>/dev/null || echo 0); case "$last" in ''|*[!0-9]*) last=0;; esac
  [ $((now - last)) -lt "$STALLW_REALARM" ] && return 0      # rate-limit outbound alerts
  echo "$now" > "$STALLW_LAST_ALARM"
  if [ "$sev" = "hard" ]; then
    ( DISPLAY="${DISPLAY:-:0}" notify-send -u critical -t 0 --expire-time 0 "pi-hunt: STALLED [$class]" "$msg" >/dev/null 2>&1 & )
    ( paplay "$STALLW_SOUND" >/dev/null 2>&1 & ); ( paplay "$STALLW_SOUND" >/dev/null 2>&1 & )
    ( spd-say "Bug bounty hunt stalled. $class. Please check." >/dev/null 2>&1 & )
    stallw_webhook "pi-hunt STALLED [$class] — $msg"
  else
    stallw_webhook "pi-hunt early-warning [$class] — $msg"
  fi
}

stallw_check(){ # 0 = alarmed, 1 = healthy / not running
  local newest now age sig state wch cls act
  if ! pi_alive; then
    stallw_write_state "NO_HUNT" 0 "GONE - -" "no pi process (hunt down or paused)"
    printf '%s stall-watch: no pi process running\n' "$(date '+%F %T')" >> "$STALLW_LOG"; return 1
  fi
  newest=$(stallw_newest_mtime); now=$(date +%s)
  if [ "$newest" -le 0 ]; then
    stallw_write_state "WARMUP" 0 "- - -" "pi up but no transcript/casefile yet"
    printf '%s stall-watch: pi alive but no transcript/casefile found under %s\n' "$(date '+%F %T')" "$STALLW_SESS_DIR" >> "$STALLW_LOG"; return 1
  fi
  age=$((now - newest))
  if [ "$age" -lt "$STALLW_FASTPATH" ]; then
    stallw_write_state "HEALTHY" "$age" "progressing" "last write ${age}s ago"
    printf '%s stall-watch: healthy (last write %ds ago; fast=%ds hard=%ds)\n' "$(date '+%F %T')" "$age" "$STALLW_FASTPATH" "$STALLW_THRESH" >> "$STALLW_LOG"
    return 1
  fi
  sig=$(stallw_proc_signal); state=${sig%% *}; wch=${sig##* }
  # classify by what the ROOT is waiting on first — an I/O wait is the real hang signal even if
  # a subagent is burning minor background CPU (don't let idle event-loop ticks read as SPINNING).
  if stallw_provider_down; then
    cls="PROVIDER_DOWN"; act="coordinator provider down (see coord-health.log); failover staged in .coordinator-model — RELAUNCH to apply"
  else
    case "$wch" in
      *epoll*|*poll*|*futex*|*sk_wait*|*inet*|*tcp*|*read_*|*wait_woken*)
        cls="HUNG_IO"; act="root blocked in '$wch', no progress ${age}s — hung/stalled LLM stream (idle-timeout not catching it); relaunch (or kill the stuck subagent)" ;;
      *)
        if [ "$state" = "ONCPU" ]; then
          cls="SPINNING"; act="on-CPU and NOT I/O-blocked, no write ${age}s — stuck in a local loop; relaunch if it persists"
        else
          cls="IDLE"; act="no progress ${age}s; state=$state wchan=$wch — check the TUI" ;
        fi ;;
    esac
  fi
  if [ "$age" -ge "$STALLW_THRESH" ] || [ "$cls" = "PROVIDER_DOWN" ] || [ "$cls" = "SPINNING" ]; then
    stallw_write_state "$cls" "$age" "$sig" "$act"
    stallw_alarm hard "$cls" "$age" "$sig" "idle ${age}s — $act"
  else
    stallw_write_state "$cls" "$age" "$sig" "$act"
    stallw_alarm soft "$cls" "$age" "$sig" "idle ${age}s (early warning) — $act"
  fi
  return 0
}

stallw_watch(){ local iv="${1:-120}"; echo $$ > "$STALLW_PID"; ok "stall-watch (pid $$, every ${iv}s; soft=${STALLW_FASTPATH}s hard=${STALLW_THRESH}s). Log: $STALLW_LOG"; trap 'rm -f "$STALLW_PID"; exit 0' INT TERM; stallw_check || true; while sleep "$iv"; do stallw_check || true; done; }

stallw_status(){
  local newest now age
  if pi_alive; then echo "  pi process          : running (pid $(stallw_pids | tr '\n' ' '))"; else echo "  pi process          : not running"; fi
  newest=$(stallw_newest_mtime); now=$(date +%s)
  if [ "$newest" -gt 0 ]; then age=$((now - newest)); echo "  last hunt activity  : ${age}s ago ($(date -d "@$newest" '+%F %T' 2>/dev/null))"; else echo "  last hunt activity  : none found"; fi
  echo "  thresholds          : soft=${STALLW_FASTPATH}s  hard=${STALLW_THRESH}s  re-alarm=${STALLW_REALARM}s"
  echo "  watching            : $STALLW_SESS_DIR + $STALLW_CASEFILE"
  if [ -n "$STALLW_WEBHOOK" ]; then echo "  out-of-band         : webhook configured"; else echo "  out-of-band         : none (export PIHUNT_ALERT_WEBHOOK=<url> for off-desk alerts)"; fi
  [ -f "$STALLW_STATE" ] && echo "  current             : $(cat "$STALLW_STATE" 2>/dev/null)"
  if [ -f "$STALLW_PID" ] && kill -0 "$(cat "$STALLW_PID" 2>/dev/null)" 2>/dev/null; then echo "  watcher             : running (pid $(cat "$STALLW_PID"))"; else echo "  watcher             : not running"; fi
  [ -f "$STALLW_LEDGER" ] && { echo "  recent stalls:"; tail -3 "$STALLW_LEDGER" 2>/dev/null | sed 's/^/    /'; }
}

stallw_report(){
  if [ ! -s "$STALLW_LEDGER" ]; then echo "no stall ledger yet ($STALLW_LEDGER)"; return; fi
  echo "stall ledger: $STALLW_LEDGER   ($(wc -l < "$STALLW_LEDGER" | tr -d ' ') events)"
  echo "  by class:"; sed -n 's/.*"class":"\([^"]*\)".*/\1/p' "$STALLW_LEDGER" | sort | uniq -c | sort -rn | sed 's/^/    /'
  echo "  last 5:"; tail -5 "$STALLW_LEDGER" | sed 's/^/    /'
}

stallw_off(){ if [ -f "$STALLW_PID" ] && kill -0 "$(cat "$STALLW_PID" 2>/dev/null)" 2>/dev/null; then kill "$(cat "$STALLW_PID")" 2>/dev/null && ok "stall-watch stopped"; else ok "no stall-watch running"; fi; rm -f "$STALLW_PID"; }

case "${1:-status}" in
  on) apply_on ;;
  off) apply_off ;;
  amd-fallback)
    case "${2:-once}" in
      once|reconcile) amdfb_reconcile || true; amdfb_status ;;
      watch) amdfb_watch "${3:-300}" ;;
      status) amdfb_status ;;
      off|stop) amdfb_off ;;
      reset) rm -f "$AMDFB_HOME_FILE" "$AMDFB_MODE_FILE"; ok "amd-fallback snapshot/mode cleared" ;;
      *) err "usage: pi-tier amd-fallback {once|watch [sec]|status|off|reset}" ;;
    esac ;;
  groq-fallback)
    case "${2:-once}" in
      once|reconcile) groqfb_reconcile || true; groqfb_status ;;
      watch) groqfb_watch "${3:-300}" ;;
      status) groqfb_status ;;
      off|stop) groqfb_off ;;
      reset) rm -f "$GROQFB_HOME_FILE" "$GROQFB_MODE_FILE"; ok "groq-fallback snapshot/mode cleared" ;;
      *) err "usage: pi-tier groq-fallback {once|watch [sec]|status|off|reset}" ;;
    esac ;;
  coord-health)
    case "${2:-once}" in
      once|reconcile) coordh_reconcile || true; coordh_status ;;
      watch) coordh_watch "${3:-120}" ;;
      status) coordh_status ;;
      off|stop) coordh_off ;;
      *) err "usage: pi-tier coord-health {once|watch [sec]|status|off}" ;;
    esac ;;
  hybrid)
    wc=0; for x in "$@"; do [ "$x" = "--coord" ] && wc=1; done
    sub="${2:-once}"; [ "$sub" = "--coord" ] && sub=once
    case "$sub" in
      once|reconcile) hybrid_reconcile "$wc" || true; hybrid_status ;;
      watch) ivv="${3:-120}"; case "$ivv" in --coord) ivv=120;; esac; hybrid_watch "$ivv" "$wc" ;;
      status) hybrid_status ;;
      off|stop) hybrid_off ;;
      *) err "usage: pi-tier hybrid {once|watch [sec]|status|off} [--coord]";;
    esac ;;
  set-fast)
    [ -n "${2:-}" ] || { err "usage: pi-tier set-fast <provider/model>"; exit 1; }
    set_state "$FAST_STATE" "$2" "fast" ;;
  set-hunter)
    [ -n "${2:-}" ] || { err "usage: pi-tier set-hunter <provider/model>"; exit 1; }
    set_state "$HUNTER_STATE" "$2" "hunter" ;;
  set-flagship)
    [ -n "${2:-}" ] || { err "usage: pi-tier set-flagship <model>"; exit 1; }
    set_state "$FLAGSHIP_STATE" "$2" "Kimi fallback" ;;
  set-coordinator)
    [ -n "${2:-}" ] || { err "usage: pi-tier set-coordinator <provider/model[:thinking]>"; exit 1; }
    set_state "$COORD_STATE" "$2" "coordinator" ;;
  set-agent)
    [ -n "${2:-}" ] && [ -n "${3:-}" ] || { err "usage: pi-tier set-agent <agent> <provider/model>"; exit 1; }
    set_agent "$2" "$3" ;;
  clear-agent)
    [ -n "${2:-}" ] || { err "usage: pi-tier clear-agent <agent>"; exit 1; }
    clear_agent "$2" ;;
  status|"") status ;;
  concurrency)
    case "${2:-once}" in
      once|reconcile) conc_reconcile || true; conc_status ;;
      watch) conc_watch "${3:-300}" ;;
      status) conc_status ;;
      off|stop) conc_off ;;
      *) err "usage: pi-tier concurrency {once|watch [sec]|status|off}" ;;
    esac ;;
  stall-watch)
    case "${2:-once}" in
      once|check) stallw_check || true; stallw_status ;;
      watch) stallw_watch "${3:-120}" ;;
      status) stallw_status ;;
      report) stallw_report ;;
      off|stop) stallw_off ;;
      *) err "usage: pi-tier stall-watch {once|watch [sec]|status|report|off}" ;;
    esac ;;
  -h|--help|help) sed -n '2,/^set -uo pipefail/p' "$0" | sed '/^set -uo pipefail/d; s/^#\s\?//' ;;
  *) err "usage: pi-tier {on|off|status|set-fast|set-hunter|set-flagship|set-coordinator|set-agent|clear-agent|hybrid|amd-fallback|coord-health|concurrency|stall-watch}";;
esac
