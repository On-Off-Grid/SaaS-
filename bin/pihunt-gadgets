#!/usr/bin/env python3
"""pihunt-gadgets — synthesise the gadget graph into escalation leverage.

Reads a per-program capability graph (gadget-graph.jsonl), re-arm triggers
(rearm-triggers.jsonl), and the latest program-updates snapshot (live-intel/
updates-*.json, written by `pihunt-updates`), and answers the one question a flat
vector list can't: *which single missing primitive, if obtained, unblocks the most
(and highest-tier) escalation chains?*

A re-arm trigger arms on ANY of: when_capability (a confirmed gadget now grants it),
when_scope_added (a matching asset just entered scope — from the updates delta), or
when_status (the program status now equals the value, e.g. "Open"). The scope/status
conditions close the loop from `pihunt-updates` so an Intigriti scope change re-opens
a parked dead-end. RAG is NOT read here: it is the agents' store (updates feed RAG via
the scope-loader; the hunters write results back into gadget-graph.jsonl, which this
tool synthesises).

Model
-----
  gadget : status=confirmed -> GRANTS capabilities. negative = probe ran, the
           capability does NOT exist (recorded so it isn't re-hunted blindly).
  chain  : NEEDS capabilities; grants an outcome at a `tier`. Composable when every
           need is granted by a confirmed gadget.
Capability classes (by prefix):
  probe.*   -> an observation you can make THIS run with the fleet  (ACTIONABLE)
  account.* -> provisioning state
  else      -> an external gadget that must be DISCOVERED (redirect./ciphertext./...)

Only reads graph/trigger/case files; prints no credentials.

Usage:
  pihunt-gadgets rank     [--program P]   ranked missing-capability shopping list
  pihunt-gadgets chains   [--program P]   per-chain composability
  pihunt-gadgets patterns [--program P]   each chain -> the practitioner pattern it
                                          instantiates + the next link it predicts
  pihunt-gadgets suggest  [--program P]   the single best next action (rank+pattern)
  pihunt-gadgets triggers [--program P]   which re-arm triggers are ARMED vs WAITING
  pihunt-gadgets check    [--program P]   exit 10 if any trigger is ARMED (for recon)
  pihunt-gadgets report   [--program P]   write structured-recon/gadgets-report.md
Default program: from config/engagement.toml (or $PIHUNT_PROGRAM / --program).
"""
import json
import os
import sys
import glob as _glob
import fnmatch

TIERS = {"critical": 4, "high": 3, "medium": 2, "low": 1, "info": 0}
def _find_root():
    # Walk up from the working directory to the repo (dir containing reports/),
    # so the tool works bare-on-PATH from the repo root or any subdir. Fall back
    # to the parent of the script's bin/ dir (repo-relative invocation).
    d = os.getcwd()
    while True:
        if os.path.isdir(os.path.join(d, "reports")) or os.path.exists(os.path.join(d, ".pihunt-root")):
            return d
        p = os.path.dirname(d)
        if p == d:
            return os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        d = p


ROOT = _find_root()


def _engagement_program():
    # Program slug from the TOML engagement config (local override wins), so a
    # cloned harness carries its own engagement instead of a hardcoded default.
    import tomllib
    for name in ("engagement.local.toml", "engagement.toml"):
        p = os.path.join(ROOT, "config", name)
        if not os.path.exists(p):
            continue
        try:
            with open(p, "rb") as fh:
                eng = tomllib.load(fh).get("engagement", {}) or {}
        except Exception:
            continue
        if eng.get("program"):
            return str(eng["program"])
    return None


def program(argv):
    for i, a in enumerate(argv):
        if a == "--program" and i + 1 < len(argv):
            return argv[i + 1]
    return os.environ.get("PIHUNT_PROGRAM") or _engagement_program() or "example-program"


def recon_dir(prog):
    return os.path.join(ROOT, "reports", prog, "structured-recon")


def load_jsonl(path):
    out = []
    if not os.path.exists(path):
        return out
    with open(path) as f:
        for ln in f:
            ln = ln.strip()
            if not ln:
                continue
            try:
                out.append(json.loads(ln))
            except json.JSONDecodeError as e:
                sys.stderr.write(f"warn: bad line in {path}: {e}\n")
    return out


def load_graph(prog):
    nodes = load_jsonl(os.path.join(recon_dir(prog), "gadget-graph.jsonl"))
    gadgets = [n for n in nodes if n.get("kind") == "gadget"]
    chains = [n for n in nodes if n.get("kind") == "chain"]
    granted = set()      # capabilities a confirmed gadget grants
    negative = set()     # capabilities a probe ran and found absent
    for g in gadgets:
        if g.get("status") == "confirmed":
            for c in g.get("grants", []):
                granted.add(c)
        elif g.get("status") == "negative":
            # A negative probe records the ABSENT capability either in `grants`
            # or (older rows) as the node `id` itself. Harvest both so a chain
            # that NEEDS a probed-negative capability is reconciled as dead
            # instead of resurfacing as a top actionable primitive. The `.`
            # guard skips opaque ids (p_harness_session_authz) whose capability
            # lives in `grants`; capability ids (probe.microvm_cross_id) match.
            for c in g.get("grants", []):
                negative.add(c)
            gid = g.get("id", "")
            if "." in gid:
                negative.add(gid)
    return gadgets, chains, granted, negative


def cls(cap):
    if cap.startswith("probe."):
        return "probe"
    if cap.startswith("account."):
        return "account"
    return "gadget"


CLS_LABEL = {
    "probe": "ACTIONABLE (run the probe)",
    "account": "PROVISIONING",
    "gadget": "DISCOVER external gadget",
}
# actionable first so the fleet-doable work sorts to the top within a tier
CLS_RANK = {"probe": 2, "account": 1, "gadget": 0}


def composability(chains, granted, negative=frozenset()):
    rows = []
    for ch in chains:
        needs = ch.get("needs", [])
        missing = [n for n in needs if n not in granted]
        dead_missing = [n for n in missing if n in negative]
        rows.append({
            "id": ch["id"],
            "tier": ch.get("tier", "info"),
            "status": ch.get("status", "?"),
            "case": ch.get("case"),
            "needs": needs,
            "missing": missing,
            "dead_missing": dead_missing,  # missing needs a probe already killed
            "composable": not missing,
            "note": ch.get("note", ""),
        })
    return rows


def rank_missing(rows, negative):
    """For each unmet capability, how many chains it blocks + the top tier."""
    agg = {}
    for r in rows:
        if r["composable"]:
            continue
        for cap in r["missing"]:
            a = agg.setdefault(cap, {"cap": cap, "chains": [], "tier": 0})
            a["chains"].append(r["id"])
            a["tier"] = max(a["tier"], TIERS.get(r["tier"], 0))
    items = list(agg.values())
    for a in items:
        a["class"] = cls(a["cap"])
        a["probed_negative"] = a["cap"] in negative
        a["n"] = len(a["chains"])
    items.sort(key=lambda a: (a["tier"], CLS_RANK[a["class"]], a["n"]), reverse=True)
    return items


def tier_name(v):
    for k, n in TIERS.items():
        if n == v:
            return k
    return str(v)


def cmd_rank(prog, out=sys.stdout):
    _, chains, granted, negative = load_graph(prog)
    rows = composability(chains, granted, negative)
    items = rank_missing(rows, negative)
    live = [a for a in items if not a["probed_negative"]]
    dead = [a for a in items if a["probed_negative"]]
    ncomp = sum(1 for r in rows if r["composable"])
    print(f"# Missing-primitive leverage — {prog}", file=out)
    print(f"# {len(chains)} chains, {ncomp} composable now, {len(dead)} dead-end(s) parked. "
          f"Ranked by (max tier unblocked, actionable-first, #chains).\n", file=out)
    hdr = f"{'CAPABILITY':<46} {'TIER':<9} {'#':<3} {'CLASS':<26} CHAINS"
    print(hdr, file=out)
    print("-" * len(hdr), file=out)
    for a in live:
        print(f"{a['cap']:<46} {tier_name(a['tier']):<9} {a['n']:<3} "
              f"{CLS_LABEL[a['class']]:<26} {','.join(a['chains'])}", file=out)
    if not live:
        print("(no live missing primitive — every actionable chain is composable or dead)",
              file=out)
    if dead:
        # A probe already ran these and found the capability ABSENT. Keep them
        # OUT of the actionable ranking (they are not re-huntable blindly), but
        # list them so the operator sees the chain is parked, not forgotten.
        print("\n# dead-ends — probe ran, capability ABSENT; do NOT re-hunt "
              "(re-open only via a re-arm trigger, see `pihunt-gadgets triggers`)", file=out)
        for a in dead:
            print(f"{a['cap']:<46} {tier_name(a['tier']):<9} {a['n']:<3} "
                  f"{'KILLED (probed negative)':<26} {','.join(a['chains'])}", file=out)
    return items


def cmd_chains(prog, out=sys.stdout):
    _, chains, granted, negative = load_graph(prog)
    rows = composability(chains, granted, negative)
    rows.sort(key=lambda r: (r["composable"], -TIERS.get(r["tier"], 0)))
    print(f"# Chain composability — {prog}\n", file=out)
    for r in rows:
        if r["composable"]:
            mark = "COMPOSABLE"
        elif r["dead_missing"] and len(r["dead_missing"]) == len(r["missing"]):
            # every remaining need was probed and found absent -> the chain is dead
            mark = f"DEAD (probed absent: {', '.join(r['dead_missing'])})"
        else:
            mark = f"missing: {', '.join(r['missing'])}"
            if r["dead_missing"]:
                mark += f" [dead: {', '.join(r['dead_missing'])}]"
        case = f" [{r['case']}]" if r["case"] else ""
        print(f"[{r['tier']:>8}] {r['id']:<18} {r['status']:<14} {mark}{case}", file=out)
    return rows


def load_patterns():
    """Program-agnostic chaining patterns, each sourced to a named practitioner."""
    path = os.path.join(ROOT, "knowledge", "chaining-patterns.jsonl")
    pats = [p for p in load_jsonl(path) if p.get("kind") in ("pattern", "principle")]
    return path, pats


def match_patterns(chain_node, pats):
    """A pattern matches a chain by explicit maps_to / node `pattern` tag, or by a
    grant_match token being a prefix of one of the chain's granted capabilities."""
    cid = chain_node["id"]
    grants = chain_node.get("grants", [])
    tag = chain_node.get("pattern")
    hits = []
    for p in pats:
        if p.get("kind") != "pattern":
            continue
        by_id = cid in p.get("maps_to", []) or (tag and tag == p["id"])
        by_cap = any(gm and any(g.startswith(gm) or gm in g for g in grants)
                     for gm in p.get("grant_match", []))
        if by_id or by_cap:
            hits.append(p)
    return hits


def _src_line(p):
    return "; ".join(f"{s['who']} — {s['work']} ({s['year']})"
                     for s in p.get("sources", []))


def cmd_patterns(prog, out=sys.stdout):
    _, chains, granted, negative = load_graph(prog)
    rows = {r["id"]: r for r in composability(chains, granted, negative)}
    ppath, pats = load_patterns()
    if not pats:
        print(f"# no chaining-pattern registry at {ppath}", file=out)
        return []

    def live_state(r):
        if r["composable"]:
            return 0  # composable now
        if r["dead_missing"] and len(r["dead_missing"]) == len(r["missing"]):
            return 2  # dead
        return 1      # one probe/gadget away

    print(f"# Chaining patterns — {prog}", file=out)
    print("# Each chain -> the practitioner pattern it instantiates, the NEXT link "
          "that pattern\n# predicts, and the source. Composable/actionable first.\n", file=out)
    order = sorted(chains, key=lambda c: (live_state(rows[c["id"]]),
                                          -TIERS.get(c.get("tier", "info"), 0)))
    seen = set()
    for c in order:
        if c["id"] in seen:        # a chain can have >1 node (partial + full)
            continue
        seen.add(c["id"])
        r = rows[c["id"]]
        st = ("COMPOSABLE" if r["composable"] else
              "DEAD" if live_state(r) == 2 else "needs " + ",".join(r["missing"]))
        print(f"[{c.get('tier'):>8}] {c['id']:<20} ({st})", file=out)
        matched = match_patterns(c, pats)
        if not matched:
            print("    (no pattern mapped — candidate for a new registry entry)\n", file=out)
            continue
        for p in matched:
            print(f"    ▸ {p['name']}", file=out)
            print(f"      next: {p['predicts']}", file=out)
            print(f"      src:  {_src_line(p)}", file=out)
        print(file=out)
    principles = [p for p in pats if p.get("kind") == "principle"]
    if principles:
        print("# Principles (apply across every surface):", file=out)
        for p in principles:
            print(f"    ◆ {p['name']}", file=out)
            print(f"      {p['predicts']}", file=out)
            print(f"      src:  {_src_line(p)}", file=out)
    return pats


def load_updates(prog):
    """Latest Intigriti program-updates snapshot (written by `pihunt-updates`):
    returns (current_status, delta). delta carries assetsAdded/assetsRemoved +
    status/version change flags. Empty when no snapshot exists — a program with no
    updates tracking simply never arms a scope/status trigger."""
    d = os.path.join(ROOT, "reports", prog, "live-intel")
    snaps = sorted(_glob.glob(os.path.join(d, "updates-*.json")))
    if not snaps:
        return None, {}
    try:
        with open(snaps[-1]) as fh:
            snap = json.load(fh)
    except Exception:
        return None, {}
    return (snap.get("fingerprint", {}).get("status"), snap.get("delta", {}) or {})


def _asset_match(pattern, assets):
    """Assets matching a trigger's when_scope_added pattern. Matches as a shell glob
    (so `*.digitaloceanspaces.com` works) and as a plain substring."""
    hits = []
    for a in assets:
        if fnmatch.fnmatch(a, pattern) or pattern in a:
            hits.append(a)
    return hits


def trigger_cond(t):
    """Short human description of a trigger's arming condition (for display)."""
    if t.get("when_capability"):
        return f"cap: {t['when_capability']}"
    if t.get("when_scope_added"):
        return f"scope-added: {t['when_scope_added']}"
    if t.get("when_status"):
        return f"status: {t['when_status']}"
    return "(no condition)"


def eval_triggers(prog):
    """A trigger arms when ANY of its conditions is met:
      when_capability  — the capability now exists in the graph's granted set
      when_scope_added — a matching asset just entered scope (updates snapshot delta)
      when_status      — the program status now equals this value (e.g. "Open")
    The capability condition is the original graph-internal signal; the scope/status
    conditions close the loop from `pihunt-updates` so an Intigriti scope change can
    re-open a parked dead-end. Each armed trigger is annotated with `_why`."""
    _, _, granted, _ = load_graph(prog)
    status, delta = load_updates(prog)
    added = delta.get("assetsAdded", []) or []
    trigs = [t for t in load_jsonl(os.path.join(recon_dir(prog), "rearm-triggers.jsonl"))
             if t.get("kind") != "meta"]
    armed, waiting = [], []
    for t in trigs:
        why = None
        cap = t.get("when_capability")
        if cap and cap in granted:
            why = f"capability granted: {cap}"
        if not why and t.get("when_scope_added"):
            hits = _asset_match(t["when_scope_added"], added)
            if hits:
                why = "asset entered scope: " + ", ".join(hits)
        if not why and t.get("when_status") and status == t.get("when_status"):
            why = f"program status = {status}"
        if why:
            t["_why"] = why
            armed.append(t)
        else:
            waiting.append(t)
    return armed, waiting


def cmd_triggers(prog, out=sys.stdout):
    armed, waiting = eval_triggers(prog)
    print(f"# Re-arm triggers — {prog}\n", file=out)
    if armed:
        print("## ARMED — a watched condition now holds; spend budget here:\n", file=out)
        for t in armed:
            print(f"  ★ {t['id']}  ({t.get('_why', trigger_cond(t))})", file=out)
            print(f"      reopen: {', '.join(t.get('reopen_cases', [])) or '-'} | "
                  f"arms: {', '.join(t.get('arms_chains', [])) or '-'}", file=out)
            print(f"      action: {t.get('action','')}\n", file=out)
    else:
        print("## ARMED: none\n", file=out)
    print("## WAITING — watch recon / scope for these conditions:\n", file=out)
    for t in waiting:
        print(f"  · {t['id']:<28} needs: {trigger_cond(t)}", file=out)
        print(f"      source: {t.get('source','')}", file=out)
    return armed, waiting


def cmd_suggest(prog, out=sys.stdout):
    """The single best next action: top LIVE actionable primitive + the pattern it
    instantiates + the next link that pattern predicts + a paste-ready launch line."""
    _, chains, granted, negative = load_graph(prog)
    rows = composability(chains, granted, negative)
    items = rank_missing(rows, negative)
    live = [a for a in items if not a["probed_negative"]]
    actionable = [a for a in live if a["class"] == "probe"]
    pick = actionable or live
    _, pats = load_patterns()
    print(f"# Suggested next action — {prog}\n", file=out)
    if not pick:
        armed, _ = eval_triggers(prog)
        if armed:
            print("No live actionable primitive, but a re-arm trigger is ARMED:", file=out)
            for t in armed:
                print(f"  ★ {t['id']} ({t.get('_why', trigger_cond(t))}) -> "
                      f"{t.get('action','')}", file=out)
        else:
            print("No live actionable primitive and no armed trigger. Either every chain "
                  "is composable (go test) or the frontier needs a DISCOVER gadget from "
                  "recon — see `pihunt-gadgets rank`.", file=out)
        return
    top = pick[0]
    chs = top["chains"]
    print(f"Top primitive : {top['cap']}  ({tier_name(top['tier'])}, "
          f"{CLS_LABEL[top['class']]})", file=out)
    print(f"Unblocks      : {', '.join(chs)}", file=out)
    seen = set()
    for c in [c for c in chains if c["id"] in chs]:
        if c["id"] in seen:
            continue
        seen.add(c["id"])
        hit = match_patterns(c, pats)
        if hit:
            p = hit[0]
            print(f"Pattern       : {p['name']}", file=out)
            print(f"Next link     : {p['predicts']}", file=out)
            print(f"Source        : {_src_line(p)}", file=out)
        break
    print("\nLaunch line (adjust floor/endpoint from `pihunt-authz gaps`):", file=out)
    print(f"  Hunt {prog} in Intigriti for CRITICAL. Start on {chs[0]} "
          f"({top['cap']}): authz-differential across both OWN teams (A->B, B->A, "
          f"unauth), sweep sibling verbs, confirm or kill, write the node to "
          f"gadget-graph.jsonl.", file=out)
    return top


def cmd_check(prog):
    armed, _ = eval_triggers(prog)
    if armed:
        sys.stderr.write(
            f"pihunt-gadgets: {len(armed)} ARMED trigger(s) for {prog}: "
            f"{', '.join(t['id'] for t in armed)} — run `pihunt-gadgets triggers`\n")
        return 10
    sys.stderr.write(f"pihunt-gadgets: no armed triggers for {prog}\n")
    return 0


def cmd_report(prog):
    path = os.path.join(recon_dir(prog), "gadgets-report.md")
    import io
    buf = io.StringIO()
    buf.write(f"# Gadget-graph synthesis — {prog}\n\n")
    buf.write("Generated by `pihunt-gadgets report`. Source of truth: "
              "`gadget-graph.jsonl` + `rearm-triggers.jsonl` in this directory.\n\n")
    buf.write("## 1. Where to spend the next run (ranked missing primitives)\n\n```\n")
    cmd_rank(prog, out=buf)
    buf.write("```\n\n> Actionable-class rows are probes the fleet can run now; "
              "discover-class rows wait on an external gadget recon must find.\n\n")
    buf.write("## 2. Chain composability\n\n```\n")
    cmd_chains(prog, out=buf)
    buf.write("```\n\n## 3. Chaining patterns (what a decent hunter does next)\n\n```\n")
    cmd_patterns(prog, out=buf)
    buf.write("```\n\n> Patterns + sources: `knowledge/chaining-patterns.jsonl`.\n\n")
    buf.write("## 4. Re-arm triggers\n\n```\n")
    cmd_triggers(prog, out=buf)
    buf.write("```\n")
    with open(path, "w") as f:
        f.write(buf.getvalue())
    print(f"wrote {path}")
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    cmd, prog = argv[0], program(argv[1:])
    if cmd == "rank":
        cmd_rank(prog)
    elif cmd == "chains":
        cmd_chains(prog)
    elif cmd == "patterns":
        cmd_patterns(prog)
    elif cmd == "suggest":
        cmd_suggest(prog)
    elif cmd == "triggers":
        cmd_triggers(prog)
    elif cmd == "check":
        return cmd_check(prog)
    elif cmd == "report":
        return cmd_report(prog)
    else:
        sys.stderr.write(f"unknown command: {cmd}\n")
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
