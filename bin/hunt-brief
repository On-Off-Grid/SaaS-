#!/usr/bin/env bash
# hunt-brief — read-only session orientation for a fresh agent.
#
# Answers "what state is the hunt in and what do I do next?" in one screen, with
# ZERO mutation: it never applies config, never starts a watcher, never touches the
# gadget graph. It reads the on-disk state (graph, authz, triggers, submissions, git)
# plus the program-agnostic chaining registry and prints a brief + a suggested next
# action, and mirrors it to reports/<prog>/SESSION-BRIEF.md so any later agent (or a
# SessionStart hook) has the same rapid context. The curated SESSION-HANDOFF.md is
# left untouched — this complements it, it does not overwrite it.
#
#   hunt-brief            full brief (includes a live provider/quota probe via pi-tier)
#   hunt-brief --quick    skip the network provider probe (fast; used by the hook)
#
# To ACT on the brief you run the deliberate, mutating step yourself:
#   hunt-session up       apply tiering + size concurrency, then advise watchers
#   hunt-session watchers start the safety watchers (background)
set -uo pipefail

QUICK=0
[ "${1:-}" = "--quick" ] && QUICK=1

# Shared helpers (repo-root discovery, engagement/program resolution, TOML reads).
for __l in "$(dirname "${BASH_SOURCE[0]}")/../lib/pihunt-common.sh" \
           "$HOME/.local/lib/pihunt-common.sh" "${PIHUNT_REPO:-}/lib/pihunt-common.sh"; do
  [ -r "$__l" ] && { . "$__l"; break; }
done; unset __l

# Resolve repo root by walking up to the dir containing reports/ (bare-on-PATH safe).
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)"
d="$PWD"
while [ "$d" != "/" ]; do [ -d "$d/reports" ] && { REPO="$d"; break; }; d="$(dirname "$d")"; done
export PATH="$HOME/.local/bin:$REPO/bin:$PATH"
PROG="$(command -v pihunt_program >/dev/null 2>&1 && pihunt_program)"
[ -n "$PROG" ] || PROG="${PIHUNT_PROGRAM:-example-program}"
RECON="$REPO/reports/$PROG/structured-recon"
BRIEF="$REPO/reports/$PROG/SESSION-BRIEF.md"
TUNE="$HOME/.pi/secrets/pihunt-tuning.env"

have(){ command -v "$1" >/dev/null 2>&1; }

render(){
  echo "# Session brief — $PROG"
  echo "_Auto-generated by \`hunt-brief\` at $(date '+%F %T %Z'). Read-only snapshot; the"
  echo "curated \"where to steer\" narrative is SESSION-HANDOFF.md (not regenerated)._"
  echo

  echo "## Last state"
  if have git && git -C "$REPO" rev-parse >/dev/null 2>&1; then
    echo "- git: \`$(git -C "$REPO" log -1 --oneline 2>/dev/null)\` on \`$(git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null)\`"
  fi
  if [ -f "$RECON/submissions.jsonl" ]; then
    python3 - "$RECON/submissions.jsonl" <<'PY' 2>/dev/null || true
import json,sys
rows=[json.loads(l) for l in open(sys.argv[1]) if l.strip()]
subs=[r for r in rows if r.get("kind")!="meta"]
if subs:
    s=subs[-1]
    print(f"- last submission: {s.get('case','?')} — {s.get('severity',s.get('severityClaimed','?'))} "
          f"({s.get('verdict', s.get('triage','pending'))})"
          + (f", bounty {s['bounty']}" if s.get('bounty') else ""))
    print(f"- submissions on record: {len(subs)}")
PY
  fi
  if [ -f "$RECON/gadget-graph.jsonl" ]; then
    python3 - "$RECON/gadget-graph.jsonl" <<'PY' 2>/dev/null || true
import json,sys
n=[json.loads(l) for l in open(sys.argv[1]) if l.strip()]
g=[x for x in n if x.get("kind")=="gadget"]; c=[x for x in n if x.get("kind")=="chain"]
conf=sum(1 for x in g if x.get("status")=="confirmed"); neg=sum(1 for x in g if x.get("status")=="negative")
print(f"- graph: {len(c)} chains, {len(g)} gadgets ({conf} confirmed, {neg} negative/killed)")
PY
  fi
  # Program updates: read-only, offline (reads on-disk snapshots only; no network,
  # no mutation — the fetch that refreshes them is the deliberate `pihunt-updates
  # fetch` step). Keeps the brief's zero-mutation / --quick contract intact.
  if have pihunt-updates; then
    pihunt-updates show --program "$PROG" --limit 3 2>/dev/null | sed '1d;s/^/- updates: /' | head -6
  fi
  echo

  echo "## Suggested next action (graph + chaining registry)"
  echo '```'
  have pihunt-gadgets && pihunt-gadgets suggest --program "$PROG" 2>/dev/null || echo "(pihunt-gadgets unavailable)"
  echo '```'
  echo "Exact endpoint+verb for that surface:"
  echo '```'
  have pihunt-authz && pihunt-authz gaps --program "$PROG" 2>/dev/null | sed -n '1,14p' || echo "(pihunt-authz unavailable)"
  echo '```'
  if have pihunt-gadgets && ! pihunt-gadgets check --program "$PROG" >/dev/null 2>&1; then
    echo "> ⚠ A re-arm trigger is ARMED — see \`pihunt-gadgets triggers\`."
  fi
  echo

  echo "## Quota / config state"
  if [ "$QUICK" = 1 ]; then
    if [ -f "$TUNE" ]; then
      cc="$(grep -E '^(export )?PI_SUBAGENT_MAX_CONCURRENCY=' "$TUNE" 2>/dev/null | tail -1 | sed 's/.*=//; s/#.*//; s/[" ]//g')"
      echo "- concurrency (file): ${cc:-unknown}  _(quick mode — no live probe; run \`hunt-session preflight\` for live quota)_"
    else
      echo "- (quick mode — no tuning file found; run \`hunt-session preflight\` for live quota)"
    fi
  else
    echo '```'
    have pi-tier && { pi-tier concurrency status 2>/dev/null; echo; pi-tier coord-health status 2>/dev/null; } || echo "(pi-tier unavailable)"
    echo '```'
  fi
  echo

  echo "## To act (deliberate, mutating — you run these)"
  echo "- \`hunt-session up\` — apply tiering + size concurrency to live quota, then advise watchers"
  echo "- \`hunt-session watchers\` — start the safety watchers (background)"
  echo "- then a fresh shell: \`source $TUNE\` && \`pi-hunt\`"
  echo
  echo "_Routine: docs/operator/OPERATOR-GUIDE.md · Reading the graph: docs/operator/reading-the-steer-output.md · Curated steer: SESSION-HANDOFF.md_"
}

# Write the file (best-effort) and print the same content to stdout (for the hook).
if render > "$BRIEF" 2>/dev/null; then
  cat "$BRIEF"
else
  render   # reports/ unwritable for some reason — still give the operator the brief
fi
