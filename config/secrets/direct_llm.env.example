# direct_llm.env — direct provider keys used by the mechanical/fallback tiers.
# Copy to ~/.pi/secrets/direct_llm.env and fill in the ones you use.
#   MISTRAL_API_KEY   — Mistral (mechanical tier: codestral);   https://console.mistral.ai/
#   GOOGLE_AI_KEY     — Google AI Studio (google-direct provider); https://aistudio.google.com/apikey
#   FREELLM_POOL_KEY  — local freellm pool proxy (optional; see config/providers.toml)
export MISTRAL_API_KEY=""
export GOOGLE_AI_KEY=""
export FREELLM_POOL_KEY=""
