# amd.env — AMD GPU Cloud (free DeepSeek tier, the default hunter/coordinator model).
# Copy to ~/.pi/secrets/amd.env and fill in. Key from the AMD Developer Cloud console.
# RADEON_BASE_URL must match the provider baseUrl in config/providers.toml.
export RADEON_API_KEY=""
export RADEON_BASE_URL="https://developer.amd.com.cn/radeon/api/v1"
