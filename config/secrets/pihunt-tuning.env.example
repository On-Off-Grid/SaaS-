# pihunt-tuning.env — local subagent-runner tuning (per-machine).
#
# In the unified config this file is GENERATED from the selected machine profile
# (config/machines.toml) by `pihunt-config build --machine <name>`. This template
# documents the knobs; a fresh install seeds safe defaults for a 4-core/8GB box.
#
#   PI_SUBAGENT_MAX_CONCURRENCY  simultaneous subagents (pi-tier sizes this to live quota,
#                                capped by the machine profile ceiling)
#   PI_SUBAGENT_MAX_QUEUE        queued subagents beyond the concurrency limit
#   PI_SUBAGENT_RAM_FLOOR_MB     refuse to spawn when free RAM drops below this
#   PI_SUBAGENT_RAM_WAIT_MS      poll interval while waiting on the RAM floor
#   PI_SUBAGENT_DISCONFIRM       disconfirmation sweeps (0/1)
#   PI_SUBAGENT_MCP_PROFILES     comma-separated MCP tool profiles to expose to subagents
export PI_SUBAGENT_MAX_CONCURRENCY=3
export PI_SUBAGENT_MAX_QUEUE=6
export PI_SUBAGENT_RAM_FLOOR_MB=1500
export PI_SUBAGENT_RAM_WAIT_MS=2000
export PI_SUBAGENT_DISCONFIRM=1
export PI_SUBAGENT_MCP_PROFILES=""
