# intigriti.env — Intigriti researcher API (scope sync + program-updates tracking).
# Copy to ~/.pi/secrets/intigriti.env and fill in. Generate the token on your
# Intigriti researcher account's Personal Access Tokens page.
#
# INTIGRITI_APP   = the Bearer token sent as `Authorization: Bearer $INTIGRITI_APP`
#                   on every researcher-API call (scope-loader, the hunter prompts,
#                   and `pihunt-updates`). This is a TOKEN, not a handle/slug.
# INTIGRITI_TOKEN = secondary researcher token; reserved, not currently consumed by
#                   the harness. Leave blank unless a tool documents a use for it.
export INTIGRITI_APP=""
export INTIGRITI_TOKEN=""
